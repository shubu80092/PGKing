<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]?.ToString().Contains("PGKing", StringComparison.OrdinalIgnoreCase) == true ? ViewData["Title"] : ViewData["Title"] + " - PGKing")</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true" />
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }
    @if (ViewData["MetaKeywords"] != null)
    {
        <meta name="keywords" content="@ViewData["MetaKeywords"]" />
    }
    @if (ViewData["CanonicalUrl"] != null)
    {
        <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    }
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PGKing.UI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "xvfdz2iw1u");
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PWXP601E98"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PWXP601E98');
    </script>
</head>
<body class="@(ViewData["IsHomePage"] != null ? "home-page-body" : "")">
    <header class="fixed-top header-wrapper">
        <!-- Topbar for Contact Details and Social Links -->
        <div class="header-topbar py-2 d-none d-lg-block">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-4">
                    <span class="text-white-50"><i class="fas fa-phone-alt me-2 text-primary"></i> +91 96285 11173</span>
                    <span class="text-white-50"><i class="fas fa-envelope me-2 text-primary"></i> pgkingmumbai@pgking.in</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="https://wa.me/919628511173" target="_blank" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light @(ViewData["IsHomePage"] != null ? "navbar-luxury" : "")">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="PGKing Logo" class="navbar-logo">
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Properties">Properties</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Team">Team</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <main role="main" style="@(ViewData["IsHomePage"] != null ? "" : "padding-top: 120px;")">
        @RenderBody()
    </main>

    <!-- Floating WhatsApp Icon -->
    <a href="https://wa.me/919628511173" class="whatsapp-float" target="_blank" aria-label="Chat with us on WhatsApp">
        <i class="fab fa-whatsapp"></i>
    </a>

    <style>
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 40px;
            right: 40px;
            background-color: #25d366;
            color: #FFF;
            border-radius: 50px;
            text-align: center;
            font-size: 35px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .whatsapp-float:hover {
            color: #FFF;
            transform: scale(1.1);
            box-shadow: 0 6px 14px rgba(0,0,0,0.2);
        }
    </style>

    <footer id="footer" class="pt-5 pb-4 mt-auto @(ViewData["IsHomePage"] != null ? "luxury-footer" : "")">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-md-4 col-lg-4 col-xl-3 mx-auto mb-4">
                    <h5 class="text-uppercase fw-bold mb-4 @(ViewData["IsHomePage"] != null ? "luxury-footer-title" : "")">
                        <img src="~/images/logo.png" alt="PGKing Logo" class="footer-logo">
                    </h5>
                    <p>
                        Providing premium living spaces from hostels, PGs to studio apartments. Your comfort is our priority.
                    </p>
                    <div class="d-flex gap-3 mt-4 footer-social-links">
                        <a href="https://wa.me/919628511173" target="_blank" class="footer-social-icon" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                    <h6 class="text-uppercase fw-bold mb-4 @(ViewData["IsHomePage"] != null ? "luxury-footer-title" : "")">Links</h6>
                    <p><a href="/" class="text-decoration-none">Home</a></p>
                    <p><a href="/#properties" class="text-decoration-none">Properties</a></p>
                    <p><a asp-controller="Home" asp-action="AboutUs" class="text-decoration-none">About Us</a></p>
                    <p><a asp-controller="Admin" asp-action="Dashboard" class="text-decoration-none"><i class="fas fa-lock me-1"></i> Admin Login</a></p>
                </div>
                <div class="col-md-5 col-lg-4 col-xl-4 mx-auto mb-md-0 mb-4">
                    <h6 class="text-uppercase fw-bold mb-4 @(ViewData["IsHomePage"] != null ? "luxury-footer-title" : "")">Contact</h6>
                    <p><i class="fas fa-home text-primary me-2"></i> A- 129, First Floor, PG KING , BMC MARKET , 78 Business Park, Station Road , Bhandup West , Mumbai 400078</p>
                    <p><i class="fas fa-envelope text-primary me-2"></i> pgkingmumbai@pgking.in</p>
                    <p><i class="fas fa-phone text-primary me-2"></i> +91 96285 11173</p>
                </div>
            </div>
        </div>
        <div class="text-center p-3 mt-3 border-top border-secondary @(ViewData["IsHomePage"] != null ? "luxury-footer-bottom" : "")">
            &copy; 2026 Copyright: PGKing
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(window).scroll(function() {
            if ($(this).scrollTop() > 50) {
                $('.header-wrapper').addClass('scrolled');
                $('.navbar').addClass('scrolled');
            } else {
                $('.header-wrapper').removeClass('scrolled');
                $('.navbar').removeClass('scrolled');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
