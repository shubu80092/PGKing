<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true" />
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    
    <style>
        body { background-color: #F1F5F9 !important; }
        .admin-wrapper { display: flex; min-height: 100vh; }
        .main-content-wrapper { flex-grow: 1; display: flex; flex-direction: column; min-width: 0; background-color: #F8FAFC; }
        .content-body { padding: 30px; }
        
        /* Dashboard Card Overrides for Admin */
        .dashboard-card { 
            background: white; 
            border-radius: 1.2rem; 
            padding: 24px; 
            display: flex; 
            align-items: center; 
            transition: transform 0.3s;
        }
        .dashboard-card:hover { transform: translateY(-5px); }
        .dashboard-icon { 
            width: 56px; height: 56px; 
            border-radius: 1rem; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 1.5rem; 
            margin-right: 1.2rem; 
        }
        
        .icon-primary { background: rgba(0, 82, 255, 0.08); color: #0052FF; }
        .icon-success { background: rgba(16, 185, 129, 0.08); color: #10B981; }
        .icon-warning { background: rgba(245, 158, 11, 0.08); color: #F59E0B; }
        
        .dashboard-stat-title { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
        .dashboard-stat-value { font-size: 1.75rem; font-weight: 850; margin: 0; color: #1E293B; }
        
        .bg-primary-soft { background: rgba(0, 82, 255, 0.05); }

        /* Custom Scrollbar for Sidebar */
        .custom-sidebar-scroll::-webkit-scrollbar { width: 6px; }
        .custom-sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
        .custom-sidebar-scroll:hover::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Tier -->
        <partial name="_AdminSidebar" />

        <div class="main-content-wrapper">
            <!-- Header Tier -->
            <partial name="_AdminHeader" />

            <!-- Content Area -->
            <main class="content-body">
                @RenderBody()
            </main>

            <!-- Footer Tier -->
            <partial name="_AdminFooter" />
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            // Sidebar toggle for mobile
            $('#sidebarToggle').click(function() {
                $('.admin-sidebar').toggleClass('d-none');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
