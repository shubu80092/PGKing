@{
    ViewData["Title"] = "Our Services";
}

<section class="section-padding bg-light" style="padding-top: 150px; padding-bottom: 80px;">
    <div class="container text-center">
        <span class="luxury-subtitle d-block mb-3">The PGKing Standard</span>
        <h1 class="luxury-title-medium text-dark mb-4">Premium <span class="text-gradient">Co-Living Services</span></h1>
        <p class="font-sans fs-5 text-muted mx-auto fw-light" style="max-width: 600px; line-height: 1.8;">
            Experience unparalleled comfort with our comprehensive suite of amenities and services designed around your lifestyle.
        </p>
    </div>
</section>

<section class="section-padding" style="padding-top: 50px; padding-bottom: 100px;">
    <div class="container">
        <div class="row g-5">
            <!-- Service 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-utensils fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Daily Home-Style Meals</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Hygiene-focused, freshly cooked breakfast, lunch, and dinner served daily. We prioritize healthy, balanced nutrition for our residents.
                    </p>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-wifi fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Enterprise-Grade Wi-Fi</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        High-speed fiber internet with backup lines, ensuring smooth connectivity for remote workers, online classes, and streaming.
                    </p>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-broom fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Professional Housekeeping</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Regular cleaning and disinfection of rooms and common spaces by trained housekeeping staff to keep your environment pristine.
                    </p>
                </div>
            </div>

            <!-- Service 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-shield-alt fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Advanced 3-Tier Security</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        24/7 CCTV surveillance, biometric access gates, and verified professional wardens to guarantee resident safety.
                    </p>
                </div>
            </div>

            <!-- Service 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-bolt fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">24/7 Power & Water Backup</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Never worry about load shedding or water shortages with our high-capacity power generators and massive dual reservoir systems.
                    </p>
                </div>
            </div>

            <!-- Service 6 -->
            <div class="col-lg-4 col-md-6">
                <div class="ox-card p-5 border-0 shadow-sm h-100 text-center text-md-start">
                    <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-tshirt fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Fully Equipped Laundry</h3>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Access to high-speed commercial washing machines and dedicated drying zones to make laundry days an absolute breeze.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
