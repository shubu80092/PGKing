@{
    ViewData["Title"] = "Contact Us";
}

<!-- Leaflet.js Map Assets -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<section class="section-padding bg-light" style="padding-top: 150px; padding-bottom: 80px;">
    <div class="container text-center">
        <span class="luxury-subtitle d-block mb-3">Get In Touch</span>
        <h1 class="luxury-title-medium text-dark mb-4">Contact <span class="text-gradient">Our Office</span></h1>
        <p class="font-sans fs-5 text-muted mx-auto fw-light" style="max-width: 600px; line-height: 1.8;">
            Have questions about our properties or services? Our team is ready to help you find your perfect stay.
        </p>
    </div>
</section>

<section class="section-padding" style="padding-top: 50px; padding-bottom: 100px;">
    <div class="container">
        <div class="row g-5">
            <!-- Contact Form -->
            <div class="col-lg-6">
                <div class="ox-card p-5 border-0 shadow-sm">
                    <h3 class="fw-bold mb-4" style="font-size: 1.8rem; font-family: 'Cormorant Garamond', serif !important;">Send Us a Message</h3>
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Contact" method="post" class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Your Name</label>
                            <input type="text" name="name" class="form-control rounded-3 border-light shadow-none p-3" placeholder="Enter name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Phone Number</label>
                            <input type="tel" name="phone" class="form-control rounded-3 border-light shadow-none p-3" placeholder="Enter phone" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small">Email Address</label>
                            <input type="email" name="email" class="form-control rounded-3 border-light shadow-none p-3" placeholder="Enter email" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small">Message</label>
                            <textarea name="message" class="form-control rounded-3 border-light shadow-none p-3" rows="5" placeholder="How can we help you?" required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 fw-bold">Send Message</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Address and Interactive Map Details -->
            <div class="col-lg-6">
                <div class="d-flex flex-column h-100 justify-content-between">
                    <!-- Office Details -->
                    <div class="ox-card p-5 border-0 shadow-sm mb-4">
                        <h3 class="fw-bold mb-4" style="font-size: 1.8rem; font-family: 'Cormorant Garamond', serif !important;">Office Information</h3>
                        
                        <div class="d-flex align-items-start mb-4">
                            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0; background: rgba(0, 82, 255, 0.08);">
                                <i class="fas fa-map-marker-alt fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Corporate Address</h6>
                                <p class="text-muted small mb-0" style="line-height: 1.6;">
                                    A- 129, First Floor, PG KING , BMC MARKET , 78 Business Park, Station Road , Bhandup West , Mumbai 400078
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-4">
                            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0; background: rgba(0, 82, 255, 0.08);">
                                <i class="fas fa-phone-alt fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Call Booking Desk</h6>
                                <p class="text-muted small mb-0">+91 96285 11173</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0; background: rgba(0, 82, 255, 0.08);">
                                <i class="fas fa-envelope fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Email Inquiry</h6>
                                <p class="text-muted small mb-0">pgkingmumbai@pgking.in</p>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Leaflet Map Panel -->
                    <div class="ox-card p-0 border-0 shadow-sm overflow-hidden flex-grow-1" style="min-height: 300px; border-radius: 24px;">
                        <div id="officeMap" style="width: 100%; height: 100%; min-height: 300px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Leaflet JS Script -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // PGKing Office Coordinates (Bhandup West, Mumbai)
            var officeCoords = [19.1450, 72.9370];
            
            var map = L.map('officeMap', {
                center: officeCoords,
                zoom: 15,
                zoomControl: true,
                scrollWheelZoom: false
            });

            // Clean, clear CartoDB Voyager map tiles matching project style
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);

            // Custom Marker Pin Style with PGKing Royal Blue
            var officeIcon = L.divIcon({
                className: 'custom-office-pin',
                html: `<div style="background-color: #0052FF; width: 44px; height: 44px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,82,255,0.4); border: 2px solid white;">
                        <i class="fas fa-building" style="color: white; transform: rotate(45deg); font-size: 1rem;"></i>
                       </div>`,
                iconSize: [44, 44],
                iconAnchor: [22, 44],
                popupAnchor: [0, -44]
            });

            var marker = L.marker(officeCoords, { icon: officeIcon }).addTo(map);
            marker.bindPopup(`
                <div style="font-family: 'Inter', sans-serif; padding: 5px;">
                    <strong style="color: #0052FF; font-size: 1rem; display: block; margin-bottom: 4px;">PGKing Corporate Office</strong>
                    <span style="color: #4B5563; font-size: 0.8rem; display: block; line-height: 1.4;">
                        A-129, First Floor, BMC Market,<br>Station Road, Bhandup West,<br>Mumbai - 400078
                    </span>
                </div>
            `).openPopup();
        });
    </script>
}
