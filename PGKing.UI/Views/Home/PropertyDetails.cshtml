@model PGKing.Application.Entities.Property
@{
    ViewData["Title"] = Model.Title;
    var startingPrice = Model.Rooms?.Any() == true ? Model.Rooms.Min(r => r.Rent) : 0;
    
    // Combine all available images from the backend
    var allImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl)) allImages.Add(Model.ImageUrl);
    if (Model.Media != null && Model.Media.Any()) 
    {
        allImages.AddRange(Model.Media.Select(m => m.FilePath));
    }
    if (Model.Rooms != null)
    {
        foreach (var room in Model.Rooms)
        {
            if (room.Media != null)
            {
                allImages.AddRange(room.Media.Where(m => m.MediaType == "Image").Select(m => m.FilePath));
            }
        }
    }
    allImages = allImages.Distinct().ToList();
    
    var gridImages = allImages.ToList();
    while (gridImages.Count < 3) {
        gridImages.Add("https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800");
    }
}

<div class="container py-5 mt-5">
    <!-- Gallery Grid -->
    <div class="row g-2 mb-4 animate-fade-in">
        <div class="col-md-8">
            <div class="gallery-item main rounded-start-4 overflow-hidden" onclick="openLightbox(0)">
                <img src="@gridImages[0]" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=1200'">
            </div>
        </div>
        <div class="col-md-4">
            <div class="row g-2 h-100">
                <div class="col-12 h-50">
                    <div class="gallery-item rounded-end-top-4 overflow-hidden" onclick="openLightbox(1)">
                        <img src="@gridImages[1]" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1502672260266-1c1e52409818?w=800'">
                    </div>
                </div>
                <div class="col-12 h-50">
                    <div class="gallery-item rounded-end-bottom-4 overflow-hidden position-relative" onclick="openLightbox(2)">
                        <img src="@gridImages[2]" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1554995207-c18c203602cb?w=800'">
                        @if (allImages.Count > 3)
                        {
                            <div class="gallery-overlay d-flex align-items-center justify-content-center">
                                <span class="text-white fw-bold fs-4">+@(allImages.Count - 3) Photos</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Properties">Properties</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h1 class="fw-bold text-dark mb-0">@Model.Title</h1>
                </div>
                <p class="text-muted fs-5"><i class="fas fa-map-marker-alt text-primary me-2"></i> @Model.Address, @Model.City?.Name, @Model.State?.Name</p>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (!string.IsNullOrEmpty(Model.Amenities))
                    {
                        foreach (var amenity in Model.Amenities.Split(','))
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="fas fa-check text-success me-2"></i>@amenity.Trim()</span>
                        }
                    }
                </div>
            </div>

            <div class="mb-5">
                <h4 class="fw-bold mb-3 border-bottom pb-2">About this Property</h4>
                <p class="text-muted lh-lg">@Model.Description</p>
            </div>

            <div class="mb-5">
                <h4 class="fw-bold mb-4 border-bottom pb-2">Room Configurations</h4>
                <div class="row g-4">
                    @foreach (var room in Model.Rooms)
                    {
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                                <div class="p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="fw-bold mb-0">@room.SharingType</h5>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Available</span>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted small">Monthly Rent</span>
                                            <span class="fw-bold text-primary">₹@room.Rent.ToString("N0")</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Security Deposit</span>
                                            <span class="text-dark">₹@room.Deposit.ToString("N0")</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Room Specific Amenities -->
                                    @if(!string.IsNullOrEmpty(room.Amenities)) {
                                        <div class="mt-3 mb-4">
                                            <h6 class="small fw-bold text-muted mb-2">Room Features:</h6>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach(var am in room.Amenities.Split(',')) {
                                                    <span class="badge bg-light text-dark border-0 small px-2 py-1" style="font-size: 11px;"><i class="fas fa-dot-circle text-primary me-1" style="font-size: 8px;"></i> @am</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Room Specific Photos -->
                                    @if(room.Media != null && room.Media.Any(m => m.MediaType == "Image")) {
                                        <div class="row g-1 mt-2">
                                            @foreach(var rm in room.Media.Where(m => m.MediaType == "Image").Take(4)) {
                                                <div class="col-3">
                                                    <img src="@rm.FilePath" class="rounded w-100" style="height: 45px; object-fit: cover; cursor: pointer;" onclick="openLightboxByPath('@rm.FilePath')">
                                                </div>
                                            }
                                        </div>
                                    }

                                    <a href="#booking-form" class="btn btn-outline-primary w-100 rounded-pill mt-4">Book This Room</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-5">
                <h4 class="fw-bold mb-4 border-bottom pb-2">Property Location</h4>
                <div class="rounded-4 overflow-hidden shadow-sm" style="height: 400px;">
                    <iframe width="100%" height="100%" frameborder="0" style="border:0;" 
                        src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(Model.Address + ", " + Model.City?.Name + ", " + Model.State?.Name))&t=&z=15&ie=UTF8&iwloc=&output=embed" allowfullscreen></iframe>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div id="booking-form" class="card border-0 shadow rounded-4 sticky-top" style="top: 100px; z-index: 100;">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <span class="text-muted d-block small">Starting from</span>
                        <h2 class="fw-bold text-primary mb-0">₹@startingPrice.ToString("N0") <small class="text-muted fw-normal fs-6">/ month</small></h2>
                    </div>

                    <form asp-action="BookRoom" method="post" class="mb-4">
                        <input type="hidden" name="propertyId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Room Category</label>
                            <select name="roomId" class="form-select rounded-3 shadow-none" required>
                                @foreach (var room in Model.Rooms)
                                {
                                    <option value="@room.Id">@room.SharingType (₹@room.Rent.ToString("N0"))</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Your Name</label>
                            <input type="text" name="fullName" class="form-control rounded-3 shadow-none" placeholder="Enter full name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mobile Number</label>
                            <input type="tel" name="mobileNumber" class="form-control rounded-3 shadow-none" placeholder="10-digit mobile number" required pattern="[0-9]{10}">
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">Reserve My Bed</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="lightbox" onclick="handleLightboxClick(event)">
    <span class="close-btn" onclick="closeLightbox()">&times;</span>
    <div class="lightbox-content">
        <img id="lightbox-img" src="" onclick="event.stopPropagation()" onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=1200'">
        <a class="prev" onclick="changeImage(-1, event)">&#10094;</a>
        <a class="next" onclick="changeImage(1, event)">&#10095;</a>
    </div>
</div>

<style>
    .gallery-item { height: 220px; cursor: pointer; transition: all 0.3s ease; position: relative; }
    .gallery-item.main { height: 448px; }
    .gallery-item:hover { filter: brightness(0.85); }
    .gallery-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.4); pointer-events: none;
    }
    
    @@media (max-width: 768px) {
        .gallery-item.main { height: 300px; }
        .gallery-item { height: 150px; margin-bottom: 8px; }
    }

    .lightbox {
        display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.9); backdrop-filter: blur(5px);
    }
    .lightbox-content {
        position: relative; margin: auto; display: flex; align-items: center; justify-content: center;
        height: 100%; width: 100%;
    }
    #lightbox-img { max-height: 85vh; max-width: 85%; border-radius: 8px; }
    .close-btn {
        position: absolute; top: 30px; right: 40px; color: #fff; font-size: 50px;
        cursor: pointer; z-index: 10001;
    }
    
    .prev, .next {
        cursor: pointer; position: absolute; top: 50%; width: auto; padding: 25px;
        margin-top: -50px; color: white; font-weight: bold; font-size: 40px;
        transition: 0.3s; user-select: none; text-decoration: none; z-index: 10002;
    }
    .next { right: 5%; }
    .prev { left: 5%; }
    .prev:hover, .next:hover { color: #primary; background: rgba(255,255,255,0.1); border-radius: 50%; }
</style>

@section Scripts {
    <script>
        var lightboxImages = @Html.Raw(Json.Serialize(allImages.Count > 0 ? allImages : gridImages));
        var currentIndex = 0;

        function openLightbox(index) {
            currentIndex = index;
            document.getElementById('lightbox-img').src = lightboxImages[currentIndex];
            document.getElementById('lightbox').style.display = "block";
            document.body.style.overflow = 'hidden';
        }

        function openLightboxByPath(path) {
            var index = lightboxImages.indexOf(path);
            if (index !== -1) {
                openLightbox(index);
            } else {
                currentIndex = 0;
                document.getElementById('lightbox-img').src = path;
                document.getElementById('lightbox').style.display = "block";
                document.body.style.overflow = 'hidden';
            }
        }

        function closeLightbox() {
            document.getElementById('lightbox').style.display = "none";
            document.body.style.overflow = 'auto';
        }

        function changeImage(n, event) {
            if (event) event.stopPropagation();
            currentIndex += n;
            if (currentIndex >= lightboxImages.length) currentIndex = 0;
            if (currentIndex < 0) currentIndex = lightboxImages.length - 1;
            document.getElementById('lightbox-img').src = lightboxImages[currentIndex];
        }

        function handleLightboxClick(e) {
            if (e.target.id === 'lightbox' || e.target.className === 'lightbox-content') {
                closeLightbox();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (document.getElementById('lightbox').style.display === "block") {
                if (e.key === "Escape") closeLightbox();
                if (e.key === "ArrowLeft") changeImage(-1);
                if (e.key === "ArrowRight") changeImage(1);
            }
        });
    </script>
}
