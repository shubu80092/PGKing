@model PGKing.Application.Entities.Property
@{
    ViewData["Title"] = Model.Title + " - Property Details";
    var allImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl)) allImages.Add(Model.ImageUrl);
    if (Model.Media != null) allImages.AddRange(Model.Media.Select(m => m.FilePath));
    if (Model.Flats != null)
    {
        foreach (var flat in Model.Flats)
        {
            if (flat.Media != null) allImages.AddRange(flat.Media.Select(m => m.FilePath));
            if (flat.Rooms != null)
            {
                foreach (var room in flat.Rooms)
                {
                    if (room.Media != null) allImages.AddRange(room.Media.Select(m => m.FilePath));
                }
            }
        }
    }
}

<style>
    /* Premium Luxury Styles for Details Page */
    body {
        background-color: var(--luxury-cream-soft) !important;
        color: var(--luxury-text-dark) !important;
    }
    
    .breadcrumb-item a {
        color: var(--luxury-muted) !important;
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        transition: color 0.3s;
        text-decoration: none;
    }
    
    .breadcrumb-item a:hover {
        color: var(--luxury-burgundy) !important;
    }
    
    .breadcrumb-item.active {
        color: var(--luxury-burgundy) !important;
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
    }
    
    .property-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 400;
        color: var(--luxury-text-dark);
        line-height: 1.1;
    }
    
    .property-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: var(--luxury-muted);
    }
    
    .property-btn-action {
        border-radius: 50px;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        transition: all 0.3s;
        border: 1px solid var(--luxury-border);
        background: #ffffff;
        color: var(--luxury-text-dark);
    }
    
    .property-btn-action:hover {
        background: var(--luxury-cream);
        border-color: var(--luxury-burgundy);
        color: var(--luxury-burgundy);
    }
    
    .ox-gallery { 
        display: grid; 
        grid-template-columns: 2fr 1fr 1fr; 
        grid-template-rows: 250px 250px; 
        gap: 12px; 
        border-radius: 12px; 
        overflow: hidden; 
        margin-bottom: 30px; 
    }
    .ox-gallery-item { position: relative; cursor: pointer; overflow: hidden; }
    .ox-gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .ox-gallery-item:hover img { transform: scale(1.05); }
    .ox-gallery-item.main { grid-row: span 2; }
    
    .ox-main-content { display: flex; gap: 40px; }
    .ox-left-col { flex: 0 0 65%; }
    .ox-sidebar { flex: 0 0 35%; }

    .ox-card {
        background: #ffffff;
        border: 1px solid rgba(92, 13, 24, 0.08);
        border-radius: 12px;
        box-shadow: var(--luxury-shadow);
        transition: all 0.3s;
    }

    .ox-section-title { 
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.65rem; 
        font-weight: 500; 
        margin-bottom: 25px; 
        display: flex; 
        align-items: center; 
        gap: 12px; 
        color: var(--luxury-text-dark);
    }
    .ox-section-title::after { 
        content: ''; 
        height: 1px; 
        flex-grow: 1; 
        background: rgba(92, 13, 24, 0.15); 
    }

    .ox-tabs { display: flex; gap: 12px; margin-bottom: 25px; border-bottom: 1px solid rgba(92, 13, 24, 0.1); padding-bottom: 15px; }
    .ox-tab-btn { border: none; background: transparent; padding: 10px 25px; border-radius: 50px; font-weight: 700; color: var(--luxury-muted); cursor: pointer; transition: all 0.3s; }
    .ox-tab-btn.active { background: var(--luxury-burgundy); color: var(--luxury-cream); box-shadow: 0 8px 15px rgba(92, 13, 24, 0.15); }

    .flat-option-card {
        background: #ffffff;
        border: 1px solid rgba(92, 13, 24, 0.08);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.01);
        transition: all 0.3s;
    }

    .ox-package-card { 
        background: #ffffff; 
        border: 1px solid rgba(92, 13, 24, 0.08); 
        border-radius: 12px; 
        padding: 22px; 
        margin-bottom: 20px; 
        transition: all 0.3s; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .ox-package-card:hover { 
        border-color: var(--luxury-burgundy); 
        box-shadow: 0 10px 25px rgba(92, 13, 24, 0.06); 
        background: var(--luxury-cream-soft); 
    }
    
    .btn-reserve-room {
        background: var(--luxury-burgundy);
        border-color: var(--luxury-burgundy);
        color: var(--luxury-cream);
        border-radius: 50px;
        padding: 8px 24px;
        font-weight: 700;
        font-size: 0.85rem;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: 1px solid var(--luxury-burgundy);
    }
    
    .btn-reserve-room:hover {
        background: var(--luxury-burgundy-hover);
        border-color: var(--luxury-burgundy-hover);
        color: var(--luxury-cream);
        transform: translateY(-1px);
    }
    
    .ox-sticky-widget { 
        position: sticky; 
        top: 110px; 
        background: #ffffff; 
        border-radius: 12px; 
        padding: 30px; 
        border: 1px solid rgba(92, 13, 24, 0.08); 
        box-shadow: var(--luxury-shadow); 
    }

    .form-control, .form-select {
        border: 1px solid rgba(92, 13, 24, 0.15) !important;
        border-radius: 8px !important;
        padding: 10px 14px !important;
        font-size: 0.9rem !important;
        transition: all 0.3s !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--luxury-burgundy) !important;
        box-shadow: 0 0 0 0.25rem rgba(92, 13, 24, 0.1) !important;
        outline: none !important;
    }

    .btn-ox-submit {
        background: var(--luxury-burgundy);
        color: var(--luxury-cream);
        border: none;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: all 0.3s;
    }

    .btn-ox-submit:hover {
        background: var(--luxury-burgundy-hover);
        color: var(--luxury-cream);
        box-shadow: 0 8px 20px rgba(92, 13, 24, 0.2);
    }

    .amenity-badge {
        display: flex;
        align-items: center;
        padding: 16px;
        border-radius: 12px;
        background: var(--luxury-cream-soft);
        border: 1px solid rgba(92, 13, 24, 0.06);
        height: 100%;
        transition: all 0.3s;
    }

    .amenity-badge:hover {
        border-color: var(--luxury-burgundy);
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(92, 13, 24, 0.05);
    }

    .amenity-icon-box {
        background: #ffffff;
        border: 1px solid rgba(92, 13, 24, 0.08);
        border-radius: 50%;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        flex-shrink: 0;
    }

    .amenity-icon-box i {
        color: var(--luxury-burgundy);
    }

    @@media (max-width: 992px) {
        .ox-main-content { flex-direction: column; }
        .ox-left-col, .ox-sidebar { flex: 0 0 100%; }
        .ox-gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 250px 150px; }
        .ox-gallery-item.main { grid-column: span 2; grid-row: span 1; }
    }
</style>

<div class="container py-5 mt-5">
    <!-- Breadcrumb & Header -->
    <div class="mb-4 animate-ox">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/Home/Properties">Properties</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h1 class="property-title mb-2">@Model.Title</h1>
                <p class="property-subtitle mb-0"><i class="fas fa-map-marker-alt me-2" style="color: var(--luxury-burgundy);"></i> @Model.Address, @Model.City?.Name</p>
            </div>
            <div class="d-none d-md-flex gap-2">
                <button id="btnSave" class="btn property-btn-action px-4 py-2 fw-semibold shadow-sm" onclick="toggleSaveProperty(@Model.Id)">
                    <i class="far fa-heart me-2" id="saveIcon"></i> <span id="saveText">Save</span>
                </button>
                <button id="btnShare" class="btn property-btn-action px-4 py-2 fw-semibold shadow-sm" onclick="shareProperty()">
                    <i class="fas fa-share-alt me-2"></i> Share
                </button>
            </div>
        </div>
    </div>

    <!-- Property Main Image -->
    <div class="animate-ox mb-4 rounded-4 overflow-hidden shadow-sm" style="height: 400px; position: relative;">
        @{
            string mainImg = !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : (Model.Media?.FirstOrDefault()?.FilePath ?? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800");
        }
        <img src="@mainImg" class="w-100 h-100" style="object-fit: cover;" alt="Property Image" />
    </div>

    <div class="ox-main-content">
        <div class="ox-left-col">
            <!-- About -->
            <div class="ox-card p-4 p-lg-5 mb-4 border-0 shadow-sm animate-ox">
                <h4 class="ox-section-title">About this Stay</h4>
                <p class="text-muted fs-5 mb-0" style="line-height: 1.8;">
                    @Model.Description
                </p>
            </div>

            <!-- Rent Options -->
            <div class="ox-card p-4 p-lg-5 mb-4 border-0 shadow-sm animate-ox">
                <h4 class="ox-section-title">Rent Options</h4>
                @if (Model.Flats != null)
                {
                    foreach (var flat in Model.Flats)
                    {
                        <div class="mb-4 p-4 flat-option-card">
                            <h6 class="fw-bold text-uppercase small mb-3" style="letter-spacing: 2px; color: var(--luxury-burgundy);">@flat.Name (@flat.BhkType)</h6>

                            @if (flat.Media != null && flat.Media.Any())
                            {
                                var flatImages = flat.Media.Select(m => m.FilePath).ToList();
                                <div class="mb-4">
                                    @if (flatImages.Count == 1)
                                    {
                                        <div class="rounded-4 overflow-hidden" style="height: 400px; cursor: pointer;" onclick="openLightboxForUrl('@flatImages[0]')">
                                            <img src="@flatImages[0]" class="w-100 h-100" style="object-fit: cover;">
                                        </div>
                                    }
                                    else if (flatImages.Count == 2)
                                    {
                                        <div class="d-flex gap-2 rounded-4 overflow-hidden" style="height: 300px;">
                                            <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[0]')"><img src="@flatImages[0]" class="w-100 h-100" style="object-fit: cover;"></div>
                                            <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[1]')"><img src="@flatImages[1]" class="w-100 h-100" style="object-fit: cover;"></div>
                                        </div>
                                    }
                                    else if (flatImages.Count == 3)
                                    {
                                        <div class="d-flex gap-2 rounded-4 overflow-hidden" style="height: 400px;">
                                            <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[0]')"><img src="@flatImages[0]" class="w-100 h-100" style="object-fit: cover;"></div>
                                            <div class="w-50 d-flex flex-column gap-2">
                                                <div class="h-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[1]')"><img src="@flatImages[1]" class="w-100 h-100" style="object-fit: cover;"></div>
                                                <div class="h-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[2]')"><img src="@flatImages[2]" class="w-100 h-100" style="object-fit: cover;"></div>
                                            </div>
                                        </div>
                                    }
                                    else if (flatImages.Count == 4)
                                    {
                                        <div class="d-flex gap-2 rounded-4 overflow-hidden" style="height: 400px;">
                                            <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[0]')"><img src="@flatImages[0]" class="w-100 h-100" style="object-fit: cover;"></div>
                                            <div class="w-50 d-flex flex-column gap-2">
                                                <div class="h-50 d-flex gap-2">
                                                    <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[1]')"><img src="@flatImages[1]" class="w-100 h-100" style="object-fit: cover;"></div>
                                                    <div class="w-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[2]')"><img src="@flatImages[2]" class="w-100 h-100" style="object-fit: cover;"></div>
                                                </div>
                                                <div class="h-50" style="cursor: pointer;" onclick="openLightboxForUrl('@flatImages[3]')"><img src="@flatImages[3]" class="w-100 h-100" style="object-fit: cover;"></div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ox-gallery animate-ox">
                                            <div class="ox-gallery-item main" onclick="openLightboxForUrl('@flatImages[0]')">
                                                <img src="@flatImages[0]">
                                            </div>
                                            <div class="ox-gallery-item" onclick="openLightboxForUrl('@flatImages[1]')">
                                                <img src="@flatImages[1]">
                                            </div>
                                            <div class="ox-gallery-item" onclick="openLightboxForUrl('@flatImages[2]')">
                                                <img src="@flatImages[2]">
                                            </div>
                                            <div class="ox-gallery-item" onclick="openLightboxForUrl('@flatImages[3]')">
                                                <img src="@flatImages[3]">
                                            </div>
                                            <div class="ox-gallery-item" onclick="openLightboxForUrl('@flatImages[4]')">
                                                <img src="@flatImages[4]">
                                                @if (flatImages.Count > 5)
                                                {
                                                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center">
                                                        <span class="text-white fw-bold fs-4">+@(flatImages.Count - 5) Photos</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (flat.Rooms != null)
                            {
                                foreach (var room in flat.Rooms)
                                {
                                    <div class="ox-package-card animate-ox">
                                        <div>
                                            <h5 class="fw-bold mb-1 font-sans text-dark" style="font-size: 1.05rem;">@room.SharingType</h5>
                                            <div class="d-flex gap-2">
                                                <span class="badge bg-light text-muted fw-bold px-2 py-1 rounded small">Deposit: ₹@room.Deposit.ToString("N0")</span>
                                                @if (room.IsOccupied) {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-1 rounded small">Occupied</span>
                                                } else {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded small">Available</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fs-3 fw-bold mb-2 text-nowrap" style="color: var(--luxury-burgundy); font-family: 'Cormorant Garamond', serif;">₹@room.Rent.ToString("N0")<small class="text-muted fw-normal font-sans" style="font-size: 0.8rem">/mo</small></div>
                                            @if (room.IsOccupied) {
                                                <button class="btn btn-secondary rounded-pill px-4 fw-semibold small" style="font-size: 0.75rem;" disabled>Occupied</button>
                                            } else {
                                                <button class="btn btn-reserve-room" onclick="openBookingModal(@room.Id, '@room.SharingType', @room.Rent)">Reserve</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>

            <!-- Amenities -->
            <div class="ox-card p-4 p-lg-5 mb-4 border-0 shadow-sm animate-ox">
                <h4 class="ox-section-title">Stay Amenities</h4>
                
                @{
                    var propAmenities = Model.Amenities?.Split(',') ?? new string[0];
                    var commonIcons = new Dictionary<string, string> {
                        { "Washing Machine", "fas fa-tshirt" },
                        { "Refrigerator", "fas fa-snowflake" },
                        { "Aqua Guard", "fas fa-tint" },
                        { "Geyser", "fas fa-hot-tub" },
                        { "Wi-Fi", "fas fa-wifi" },
                        { "Cooking and Gas Connections", "fas fa-fire" },
                        { "Separate Almira", "fas fa-door-closed" },
                        { "Beds Matters", "fas fa-bed" },
                        { "Pest control", "fas fa-bug" },
                        { "Housekeeping services", "fas fa-broom" }
                    };
                }

                <div class="row g-4">
                    @if (propAmenities.Length == 0 || (propAmenities.Length == 1 && string.IsNullOrWhiteSpace(propAmenities[0])))
                    {
                        <div class="col-12"><p class="text-muted">No property amenities listed.</p></div>
                    }
                    else
                    {
                        @foreach (var am in propAmenities)
                        {
                            var trimmedAm = am.Trim();
                            if (!string.IsNullOrEmpty(trimmedAm)) {
                                <div class="col-md-4 col-6">
                                    <div class="amenity-badge">
                                        <div class="amenity-icon-box me-3">
                                            <i class="@(commonIcons.ContainsKey(trimmedAm) ? commonIcons[trimmedAm] : "fas fa-check-circle") fs-5"></i>
                                        </div>
                                        <span class="fw-bold small text-dark">@trimmedAm</span>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- Map -->
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
            <div class="ox-card p-0 overflow-hidden border-0 shadow-sm animate-ox">
                <div class="p-4 p-lg-5 pb-0">
                    <h4 class="ox-section-title">Location</h4>
                </div>
                <div style="height: 400px; width: 100%;">
                    <div id="property-details-map" style="height: 100%; width: 100%; background: #eaeae7;"></div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="ox-sidebar">
            <div class="ox-sticky-widget animate-ox">
                <div class="text-center mb-4">
                    <div class="p-3 rounded-circle d-inline-block mb-3" style="background: rgba(92, 13, 24, 0.06); width: 65px; height: 65px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="fas fa-headset fs-3" style="color: var(--luxury-burgundy);"></i>
                    </div>
                    <h4 class="fw-bold mb-1 font-sans text-dark" style="font-size: 1.2rem;">Expert Assistance</h4>
                    <p class="text-muted small">Our team will help you find the best bed configuration here.</p>
                </div>
                
                <form asp-action="BookRoom" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <div class="mb-4">
                        <label class="small fw-bold text-muted mb-2 text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Interested In</label>
                        <select name="roomId" class="form-select fw-bold border-2" required>
                            <option value="">-- Select Option --</option>
                            @if (Model.Flats != null)
                            {
                                foreach (var flat in Model.Flats)
                            {
                                @if (flat.Rooms != null) {
                                    foreach (var room in flat.Rooms)
                                    {
                                        if (room.IsOccupied) {
                                            <option value="@room.Id" disabled>@flat.Name - @room.SharingType (Occupied)</option>
                                        } else {
                                            <option value="@room.Id">@flat.Name - @room.SharingType (₹@room.Rent.ToString("N0"))</option>
                                        }
                                    }
                                }
                            }
                        }
                        </select>
                    </div>
                    <div class="mb-3">
                        <input type="text" name="fullName" class="form-control fw-semibold" placeholder="Full Name" required />
                    </div>
                    <div class="mb-4">
                        <input type="tel" name="mobileNumber" class="form-control fw-semibold" placeholder="Mobile Number" required />
                    </div>
                    <button type="submit" class="btn btn-ox-submit w-100 py-3 shadow-lg">Schedule Visit / Book Now</button>
                </form>
                
                <div class="mt-4 pt-4 border-top text-center">
                    <p class="small text-muted mb-2">Or connect via</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="tel:+919628511173" class="btn btn-outline-success rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"><i class="fas fa-phone"></i></a>
                        <a href="https://wa.me/919628511173" class="btn btn-outline-success rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h4 class="modal-title fw-bold">Reserve Bed</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4">You are reserving: <span id="modalRoomType" class="text-primary fw-bold"></span> at <span id="modalRoomRent" class="text-primary fw-bold"></span>/mo</p>
                <form asp-action="BookRoom" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <input type="hidden" name="roomId" id="modalRoomId" />
                    <div class="mb-3">
                        <input type="text" name="fullName" class="form-control py-3 fw-semibold" placeholder="Full Name" required />
                    </div>
                    <div class="mb-4">
                        <input type="tel" name="mobileNumber" class="form-control py-3 fw-semibold" placeholder="Mobile Number" required />
                    </div>
                    <button type="submit" class="btn-ox w-100">Confirm Interest</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" onclick="handleLightboxClick(event)">
    <span class="close-btn" onclick="closeLightbox()">&times;</span>
    <div class="lightbox-content">
        <img id="lightbox-img" src="">
        <a class="prev" onclick="changeImage(-1, event)">&#10094;</a>
        <a class="next" onclick="changeImage(1, event)">&#10095;</a>
    </div>
</div>

<style>
    .lightbox { display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); }
    .lightbox-content { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; }
    #lightbox-img { max-height: 85vh; max-width: 85%; border-radius: 12px; }
    .close-btn { position: absolute; top: 30px; right: 40px; color: #fff; font-size: 50px; cursor: pointer; z-index: 10001; transition: color 0.2s; }
    .close-btn:hover { color: #ccc; }
    .prev, .next { cursor: pointer; position: absolute; top: 50%; padding: 20px; color: white; font-weight: bold; font-size: 40px; text-decoration: none; z-index: 10001; }
    .next { right: 5%; } .prev { left: 5%; }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        // Leaflet details map init
        document.addEventListener('DOMContentLoaded', () => {
            var propertyLat = @(Model.Latitude ?? 28.5355);
            var propertyLng = @(Model.Longitude ?? 77.3910);
            
            @if (!Model.Latitude.HasValue || !Model.Longitude.HasValue) {
                @:if ("@Model.City?.Name" === "Mumbai") { propertyLat = 19.0760; propertyLng = 72.8777; }
                @:else if ("@Model.City?.Name" === "Pune") { propertyLat = 18.5204; propertyLng = 73.8567; }
                @:else if ("@Model.City?.Name" === "Bengaluru") { propertyLat = 12.9716; propertyLng = 77.5946; }
                @:else if ("@Model.City?.Name" === "New Delhi") { propertyLat = 28.6139; propertyLng = 77.2090; }
            }

            if (document.getElementById('property-details-map')) {
                var detailsMap = L.map('property-details-map', {
                    zoomControl: false,
                    attributionControl: false
                });

                L.control.zoom({ position: 'bottomright' }).addTo(detailsMap);

                // Load CartoDB Voyager tiles (clear and bright)
                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                    maxZoom: 20
                }).addTo(detailsMap);

                detailsMap.setView([propertyLat, propertyLng], 15);

                var minRent = @(Model.Flats?.SelectMany(f => f.Rooms).Any() == true ? Model.Flats.SelectMany(f => f.Rooms).Min(r => r.Rent) : 0);
                var displayPrice = minRent > 0 ? "₹" + minRent.toLocaleString('en-IN') : "Contact";

                var markerHtml = '<div class="map-price-pin selected">' +
                                    '<i class="fas fa-bed me-1"></i>' +
                                    '<span>' + displayPrice + '</span>' +
                                 '</div>';
                
                var customIcon = L.divIcon({
                    html: markerHtml,
                    className: 'custom-price-marker-wrapper',
                    iconSize: [85, 30],
                    iconAnchor: [42, 15]
                });

                var marker = L.marker([propertyLat, propertyLng], { icon: customIcon }).addTo(detailsMap);
                
                var popupHtml = '<div class="map-tooltip-dark">' +
                                    '<h6 class="mb-1 text-white fw-bold">@Html.Raw(Model.Title.Replace("\"", "\\\""))</h6>' +
                                    '<p class="m-0 text-muted small" style="font-size: 0.72rem; max-width: 200px; white-space: normal;">@Html.Raw(Model.Address.Replace("\"", "\\\""))</p>' +
                                '</div>';

                marker.bindPopup(popupHtml, {
                    closeButton: false,
                    offset: L.point(0, -5),
                    className: 'dark-theme-popup'
                }).openPopup();
            }
        });

        function switchAmenities(type, event) {
            if(event) {
                document.querySelectorAll('.ox-tab-btn').forEach(btn => btn.classList.remove('active'));
                event.target.classList.add('active');
            }
            
            document.querySelectorAll('.amenity-container').forEach(c => c.style.display = 'none');
            document.getElementById(type + '-amenities').style.display = 'flex';
        }

        function openBookingModal(roomId, roomType, rent) {
            document.getElementById('modalRoomId').value = roomId;
            document.getElementById('modalRoomType').innerText = roomType;
            document.getElementById('modalRoomRent').innerText = '₹' + rent.toLocaleString();
            new bootstrap.Modal(document.getElementById('bookingModal')).show();
        }

        var lightboxImages = @Html.Raw(Json.Serialize(allImages));
        var currentIndex = 0;
        function openLightbox(index) {
            currentIndex = index;
            document.getElementById('lightbox-img').src = lightboxImages[currentIndex];
            document.getElementById('lightbox').style.display = "block";
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() { 
            document.getElementById('lightbox').style.display = "none"; 
            document.body.style.overflow = 'auto';
        }
        function openLightboxForUrl(url) {
            var idx = lightboxImages.indexOf(url);
            if(idx !== -1) openLightbox(idx);
        }
        function changeImage(n, e) {
            if(e) e.stopPropagation();
            currentIndex += n;
            if (currentIndex >= lightboxImages.length) currentIndex = 0;
            if (currentIndex < 0) currentIndex = lightboxImages.length - 1;
            document.getElementById('lightbox-img').src = lightboxImages[currentIndex];
        }
        function handleLightboxClick(e) { if(e.target.id === 'lightbox') closeLightbox(); }

        // Save Property Functionality
        const propertyId = @Model.Id;

        function toggleSaveProperty(id) {
            let saved = JSON.parse(localStorage.getItem('savedProperties') || '[]');
            const saveIcon = document.getElementById('saveIcon');
            const saveText = document.getElementById('saveText');

            if (saved.includes(id)) {
                saved = saved.filter(x => x !== id);
                saveIcon.className = 'far fa-heart me-2';
                saveText.innerText = 'Save';
            } else {
                saved.push(id);
                saveIcon.className = 'fas fa-heart me-2 text-danger';
                saveText.innerText = 'Saved';
            }
            localStorage.setItem('savedProperties', JSON.stringify(saved));
        }

        // Initialize Save state
        document.addEventListener('DOMContentLoaded', () => {
            const saved = JSON.parse(localStorage.getItem('savedProperties') || '[]');
            if (saved.includes(propertyId)) {
                document.getElementById('saveIcon').className = 'fas fa-heart me-2 text-danger';
                document.getElementById('saveText').innerText = 'Saved';
            }
        });

        // Share Functionality
        async function shareProperty() {
            const shareData = {
                title: '@Html.Raw(Model.Title.Replace("'", "\\'"))',
                text: 'Check out this awesome stay at PGKing!',
                url: window.location.href
            };
            
            try {
                if (navigator.share) {
                    await navigator.share(shareData);
                } else {
                    await navigator.clipboard.writeText(window.location.href);
                    alert('Property link copied to clipboard!');
                }
            } catch (err) {
                console.error('Error sharing:', err);
            }
        }
    </script>
}
