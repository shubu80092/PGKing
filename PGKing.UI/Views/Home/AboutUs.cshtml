@{
    ViewData["Title"] = "About Us";
}

<section class="section-padding bg-light" style="padding-top: 150px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0 animate-ox">
                <div class="pe-lg-5">
                    <span class="luxury-subtitle d-block mb-3">The PGKing Story</span>
                    <h1 class="luxury-title-medium text-dark mb-4">Redefining the <span class="text-gradient">Living Experience</span></h1>
                    <p class="font-sans fs-5 text-muted fw-light mb-5" style="line-height: 1.8;">
                        PGKing is more than just a property listing site; we are a community-focused platform dedicated to providing safe, comfortable, and premium living spaces for students and professionals.
                    </p>
                    
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="ox-card p-4 border-0 shadow-sm h-100">
                                <i class="fas fa-check-circle text-primary fs-3 mb-3"></i>
                                <h5 class="fw-bold">100% Verified</h5>
                                <p class="small text-muted mb-0">Every property is physically audited for quality.</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="ox-card p-4 border-0 shadow-sm h-100">
                                <i class="fas fa-bolt text-primary fs-3 mb-3"></i>
                                <h5 class="fw-bold">Instant Booking</h5>
                                <p class="small text-muted mb-0">Book your dream stay in just a few clicks.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 animate-ox">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=1000" class="img-fluid rounded-4 shadow-lg" style="border-radius: 40px !important;" alt="About PGKing">
                    <div class="position-absolute bottom-0 start-0 bg-white p-4 rounded-4 shadow-lg m-4 d-none d-md-block" style="border-radius: 20px !important;">
                        <div class="d-flex align-items-center">
                            <div class="display-4 fw-bold text-primary me-3">10+</div>
                            <div class="text-muted fw-bold" style="line-height: 1.2; font-size: 0.9rem;">Years of <br> Trust</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="luxury-title-medium text-dark mb-3">Our Philosophy</h2>
            <p class="text-muted fs-5 font-sans fw-light">We believe in quality over quantity.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4 animate-ox">
                <div class="text-center p-4">
                    <div class="bg-primary-soft text-primary rounded-circle mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-shield-alt fs-1"></i>
                    </div>
                    <h4 class="fw-bold">Safety First</h4>
                    <p class="text-muted">High security standards and verified neighbors for every resident.</p>
                </div>
            </div>
            <div class="col-md-4 animate-ox">
                <div class="text-center p-4">
                    <div class="bg-primary-soft text-primary rounded-circle mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-gem fs-1"></i>
                    </div>
                    <h4 class="fw-bold">Premium Quality</h4>
                    <p class="text-muted">From furniture to facilities, we never compromise on quality.</p>
                </div>
            </div>
            <div class="col-md-4 animate-ox">
                <div class="text-center p-4">
                    <div class="bg-primary-soft text-primary rounded-circle mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: rgba(0, 82, 255, 0.08);">
                        <i class="fas fa-hand-holding-heart fs-1"></i>
                    </div>
                    <h4 class="fw-bold">Community</h4>
                    <p class="text-muted">Creating spaces where you don't just stay, but belong.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-dark text-white text-center">
    <div class="container py-5">
        <h2 class="luxury-title-medium text-white mb-5">Join the <span class="text-gradient">PGKing</span> Family</h2>
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Properties" class="btn-ox py-3 px-5">Explore Stays</a>
            <a href="tel:+919628511173" class="btn-ox-outline text-white border-white py-3 px-5">Contact Us</a>
        </div>
    </div>
</section>
