@model IEnumerable<PGKing.Application.Entities.Property>
@using System.Text.Json
@using System.Linq
@{
    ViewData["Title"] = "Premium PGs & Co-Living Spaces - Explore Stays | PGKing";
    ViewData["MetaDescription"] = "Find your perfect premium PG, hostel, or co-living space with PGKing. Explore verified listings for boys, girls, and working professionals with modern amenities, WiFi, safety, and comfort assured.";
    ViewData["MetaKeywords"] = "PG, co-living spaces, hostel, room rent, premium pg, luxury hostel, PGKing, boys pg, girls pg, mumbai PGs, delhi PGs, bangalore co-living, pune pg";
    ViewData["CanonicalUrl"] = "https://pgking.in/paying-guests";
    
    var cities = ViewBag.Cities as List<PGKing.Application.Entities.City>;

    // C# helper to generate clean, URL-safe SEO URL from a Property
    string GetSeoUrl(PGKing.Application.Entities.Property property)
    {
        if (!string.IsNullOrEmpty(property.LocationSlug) && !string.IsNullOrEmpty(property.PropertySlug))
        {
            return $"/{property.LocationSlug}/{property.PropertySlug}";
        }
        var locSlug = PGKing.UI.Helpers.SeoHelper.GenerateLocationSlug(property.Area, property.City?.Name ?? property.CityName);
        var propSlug = PGKing.UI.Helpers.SeoHelper.GenerateSlug(property.Title);
        return $"/{locSlug}/{propSlug}";
    }

    // 1. Generate JSON-LD Schema markup in C# to avoid Razor parsing issues with JS/JSON braces and @ symbols
    string jsonLd = "";
    if (Model != null && Model.Any())
    {
        var itemListElement = Model.Select((property, index) => {
            var minRent = property.Flats?.SelectMany(f => f.Rooms).Any() == true 
                          ? property.Flats.SelectMany(f => f.Rooms).Min(r => r.Rent) 
                          : 0;
            var displayImg = property.ImageUrl;
            if (string.IsNullOrEmpty(displayImg)) {
                displayImg = property.Media?.FirstOrDefault()?.FilePath 
                             ?? property.Flats?.SelectMany(f => f.Media).FirstOrDefault()?.FilePath;
            }
            if (string.IsNullOrEmpty(displayImg)) {
                displayImg = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800";
            }

            return new {
                type = "ListItem",
                position = index + 1,
                url = "https://pgking.in" + GetSeoUrl(property),
                name = property.Title ?? "",
                image = displayImg,
                description = property.Description ?? "",
                address = new {
                    type = "PostalAddress",
                    streetAddress = property.Address ?? "",
                    addressLocality = property.City?.Name ?? "",
                    addressRegion = property.State?.Name ?? "",
                    addressCountry = "IN"
                }
            };
        }).ToList();

        var schemaObj = new {
            context = "https://schema.org",
            type = "ItemList",
            name = "Premium PGs & Co-Living Stays",
            description = "Explore premium PGs, hostels, and co-living spaces for boys, girls, and professionals by PGKing.",
            numberOfItems = Model.Count(),
            itemListElement = itemListElement
        };

        // Serialize and replace "type" and "context" with "@type" and "@context" to satisfy JSON-LD schema while avoiding Razor parser errors
        jsonLd = JsonSerializer.Serialize(schemaObj)
                    .Replace("\"type\":", "\"@type\":")
                    .Replace("\"context\":", "\"@context\":");
    }

    // 2. Generate Map Properties array in C# to avoid Razor syntax errors in JavaScript blocks
    string mapPropertiesJson = "[]";
    if (Model != null && Model.Any())
    {
        var mapProps = Model.Select(property => {
            var minRent = property.Flats?.SelectMany(f => f.Rooms).Any() == true 
                          ? property.Flats.SelectMany(f => f.Rooms).Min(r => r.Rent) 
                          : 0;

            var displayImg = property.ImageUrl;
            if (string.IsNullOrEmpty(displayImg)) {
                displayImg = property.Media?.FirstOrDefault()?.FilePath 
                             ?? property.Flats?.SelectMany(f => f.Media).FirstOrDefault()?.FilePath;
            }
            if (string.IsNullOrEmpty(displayImg)) {
                displayImg = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800";
            }

            double lat = property.Latitude ?? 28.5355;
            double lng = property.Longitude ?? 77.3910;
            if (!property.Latitude.HasValue || !property.Longitude.HasValue) {
                if (property.City?.Name == "Mumbai") { lat = 19.0760; lng = 72.8777; }
                else if (property.City?.Name == "Pune") { lat = 18.5204; lng = 73.8567; }
                else if (property.City?.Name == "Bengaluru") { lat = 12.9716; lng = 77.5946; }
                else if (property.City?.Name == "New Delhi") { lat = 28.6139; lng = 77.2090; }
                
                lat += ((property.Id * 17) % 100 - 50) / 1500.0;
                lng += ((property.Id * 31) % 100 - 50) / 1500.0;
            }

            return new {
                id = property.Id,
                title = property.Title ?? "",
                address = (property.Address ?? "") + ", " + (property.City?.Name ?? "") + ", " + (property.State?.Name ?? "") + ", India",
                slug = GetSeoUrl(property),
                dbLat = lat,
                dbLng = lng,
                price = minRent,
                image = displayImg
            };
        }).ToList();

        mapPropertiesJson = JsonSerializer.Serialize(mapProps);
    }
}

<!-- JSON-LD Structured Data for SEO -->
@if (!string.IsNullOrEmpty(jsonLd))
{
    <script type="application/ld+json">
        @Html.Raw(jsonLd)
    </script>
}

<main class="properties-split-container show-list" id="split-container">
    
    <!-- Left Pane: Search Filters & Property Grid -->
    <section class="properties-listings-pane" aria-labelledby="page-title">
        
        <!-- Accessible SEO Heading -->
        <h1 class="visually-hidden" id="page-title">Premium Co-Living & PGs Stays - PGKing</h1>

        <!-- Premium Top Sticky Search Bar -->
        <div class="ox-card p-3 mb-4 shadow-sm border-0 animate-ox" style="border-radius: 16px;">
            <form asp-action="Properties" method="get" class="row g-2 align-items-center">
                
                <!-- City Selection -->
                <div class="col-md-4 col-sm-6">
                    <div class="d-flex align-items-center border-end px-2" style="border-color: rgba(0, 82, 255, 0.08) !important;">
                        <i class="fas fa-map-marker-alt text-primary me-2 fs-5" aria-hidden="true"></i>
                        <label for="city-select" class="visually-hidden">Select City</label>
                        <select id="city-select" name="cityId" class="form-select border-0 bg-transparent fw-semibold shadow-none py-1" style="cursor: pointer;">
                            <option value="">All Cities</option>
                            @if (cities != null)
                            {
                                foreach (var city in cities)
                                {
                                    if (ViewBag.CurrentCityId == city.Id)
                                    {
                                        <option value="@city.Id" selected="selected">@city.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@city.Id">@city.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- PG Type Selection -->
                <div class="col-md-4 col-sm-6">
                    <div class="d-flex align-items-center border-end px-2" style="border-color: rgba(0, 82, 255, 0.08) !important;">
                        <i class="fas fa-user-friends text-primary me-2 fs-5" aria-hidden="true"></i>
                        <label for="pgtype-select" class="visually-hidden">Select PG Type</label>
                        <select id="pgtype-select" name="pgType" class="form-select border-0 bg-transparent fw-semibold shadow-none py-1" style="cursor: pointer;">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentPgType) ? "selected" : null)">Any PG Type</option>
                            <option value="Boys PG" selected="@(ViewBag.CurrentPgType == "Boys PG" ? "selected" : null)">Boys PG</option>
                            <option value="Girls PG" selected="@(ViewBag.CurrentPgType == "Girls PG" ? "selected" : null)">Girls PG</option>
                            <option value="Co-living" selected="@(ViewBag.CurrentPgType == "Co-living" ? "selected" : null)">Co-living</option>
                        </select>
                    </div>
                </div>

                <!-- Search Input & Button -->
                <div class="col-md-4 col-12 d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center flex-grow-1 px-2">
                        <i class="fas fa-search text-muted me-2" aria-hidden="true"></i>
                        <label for="search-input" class="visually-hidden">Search by Area or Name</label>
                        <input id="search-input" type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-0 bg-transparent fw-semibold shadow-none py-1" placeholder="Search area or PG name...">
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2" style="font-weight: 700; font-size: 0.85rem;">Search</button>
                </div>
            </form>
        </div>

        <!-- Info & Sort Summary Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3 px-1 animate-ox">
            <p class="text-muted mb-0 small fw-semibold">
                Showing <span class="text-dark fw-bold">@(Model?.Count() ?? 0)</span> premium properties
            </p>
            <div class="d-flex gap-2">
                <button class="btn btn-light btn-sm rounded-pill px-3 border fw-bold text-muted" onclick="toggleSort()" aria-label="Sort stays by price">
                    <i class="fas fa-sort me-1" aria-hidden="true"></i> Sort by Price
                </button>
            </div>
        </div>

        <!-- Property Grid Container -->
        <div class="row g-3 flex-grow-1" id="listings-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var property in Model)
                {
                    var minRent = property.Flats?.SelectMany(f => f.Rooms).Any() == true 
                                  ? property.Flats.SelectMany(f => f.Rooms).Min(r => r.Rent) 
                                  : 0;

                    var displayImg = property.ImageUrl;
                    if (string.IsNullOrEmpty(displayImg)) {
                        displayImg = property.Media?.FirstOrDefault()?.FilePath 
                                     ?? property.Flats?.SelectMany(f => f.Media).FirstOrDefault()?.FilePath;
                    }
                    if (string.IsNullOrEmpty(displayImg)) {
                        displayImg = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800";
                    }

                    var totalRooms = property.Flats?.SelectMany(f => f.Rooms).Count() ?? 0;

                    <article class="col-xl-6 col-md-6 col-sm-12 listing-card-item animate-ox" data-id="@property.Id" data-price="@minRent">
                        <div class="luxury-property-card" id="property-card-@property.Id" onmouseenter="onCardHover(@property.Id)" onmouseleave="onCardLeave(@property.Id)">
                            
                            <!-- Card Image -->
                            <div class="luxury-card-img-container">
                                <img src="@displayImg" class="luxury-card-img" alt="@property.Title - Premium Stay in @property.City?.Name" loading="lazy" />
                                @if (property.IsVerified)
                                {
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="verified-badge"><i class="fas fa-check-circle me-1 text-primary" aria-hidden="true"></i>VERIFIED</span>
                                    </div>
                                }
                                <div class="position-absolute top-0 start-0 m-3">
                                    @if (!string.IsNullOrEmpty(property.PgType))
                                    {
                                        var badgeBg = property.PgType.Contains("Boys") ? "bg-primary" : (property.PgType.Contains("Girls") ? "bg-danger" : "bg-success");
                                        var badgeIcon = property.PgType.Contains("Boys") ? "fa-mars" : (property.PgType.Contains("Girls") ? "fa-venus" : "fa-users");
                                        <span class="badge @badgeBg text-white rounded-pill px-3 py-1 font-sans fw-bold small"><i class="fas @badgeIcon me-1" aria-hidden="true"></i>@property.PgType</span>
                                    }
                                    else if (property.Title != null && property.Title.Contains("Boys"))
                                    {
                                        <span class="badge bg-primary text-white rounded-pill px-3 py-1 font-sans fw-bold small"><i class="fas fa-mars me-1" aria-hidden="true"></i>Boys PG</span>
                                    }
                                    else if (property.Title != null && property.Title.Contains("Girls"))
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-1 font-sans fw-bold small"><i class="fas fa-venus me-1" aria-hidden="true"></i>Girls PG</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-3 py-1 font-sans fw-bold small"><i class="fas fa-users me-1" aria-hidden="true"></i>Co-living</span>
                                    }
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <h2 class="h5 fw-bold text-dark text-truncate mb-2" title="@property.Title" style="font-family: 'Inter', sans-serif !important;">@property.Title</h2>
                                    
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-light text-primary fw-bold font-sans" style="font-size: 0.72rem;">
                                            <i class="fas fa-bed me-1" aria-hidden="true"></i>@(totalRooms > 0 ? $"{totalRooms} Rooms" : "Rooms Available")
                                        </span>
                                        <span class="badge bg-light text-success fw-bold font-sans" style="font-size: 0.72rem;">
                                            <i class="fas fa-shield-alt me-1" aria-hidden="true"></i>Premium Quality
                                        </span>
                                    </div>
                                    
                                    <p class="text-muted small text-truncate mb-3" title="@property.Address, @property.City?.Name">
                                        <i class="fas fa-map-marker-alt text-danger me-1" aria-hidden="true"></i>@property.Address, @property.City?.Name
                                    </p>
                                </div>
                                
                                <!-- Card Footer -->
                                <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-uppercase text-muted" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; display: block;">Starts From</span>
                                        <span class="fw-bold fs-5 text-primary">
                                            @(minRent > 0 ? "₹" + minRent.ToString("N0") : "Contact")<span class="text-muted fw-normal" style="font-size: 0.75rem;">/mo</span>
                                        </span>
                                    </div>
                                    <a href="@GetSeoUrl(property)" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" aria-label="View Details of @property.Title">
                                        View Stay <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="fas fa-hotel fa-3x text-muted mb-3" aria-hidden="true"></i>
                    <h3 class="fw-bold text-dark">No Stays Found</h3>
                    <p class="text-muted">Try adjusting your filters or search terms.</p>
                    <a href="/Home/Properties" class="btn btn-primary rounded-pill px-4">Reset Search</a>
                </div>
            }
        </div>
    </section>

    <!-- Right Pane: Interactive Map -->
    <aside class="properties-map-pane" aria-label="Map view of properties">
        <div id="properties-map" style="height: 100%; width: 100%; background: #eaeae7;"></div>
    </aside>

    <!-- Mobile Toggle View Switcher -->
    <button class="properties-mobile-toggle-btn" id="mobile-view-toggle" onclick="toggleMobileView()" aria-label="Switch between List and Map view">
        <i class="fas fa-map" aria-hidden="true"></i> <span>Show Map</span>
    </button>
</main>

@section Scripts {
    <!-- Google Maps API with Geocoding and Places libraries -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBrbWFXlOYpaq51wteSyFS2UjdMPOWBlQw&libraries=places"></script>
    
    <script>
        // Load Map Properties Array directly from C# serialized JSON
        var mapProperties = @Html.Raw(mapPropertiesJson);
        var latlngs = [];
        var markers = {};
        var map = null;
        var infowindow = null;

        // Custom Marker class inheriting from OverlayView for custom HTML rendering
        function CustomMarker(latlng, map, html, onClick, id) {
            this.latlng_ = latlng;
            this.html_ = html;
            this.onClick_ = onClick;
            this.id_ = id;
            this.div_ = null;
            this.setMap(map);
        }

        if (typeof google !== 'undefined') {
            CustomMarker.prototype = new google.maps.OverlayView();

            CustomMarker.prototype.onAdd = function() {
                var div = document.createElement('div');
                div.style.position = 'absolute';
                div.style.cursor = 'pointer';
                div.className = 'custom-map-marker-wrapper';
                div.innerHTML = this.html_;
                
                this.div_ = div;
                
                var panes = this.getPanes();
                panes.overlayImage.appendChild(div);
                
                var self = this;
                google.maps.event.addDomListener(div, "click", function(event) {
                    if (self.onClick_) {
                        self.onClick_();
                    }
                    google.maps.event.trigger(self, "click");
                });
            };

            CustomMarker.prototype.draw = function() {
                var overlayProjection = this.getProjection();
                var position = overlayProjection.fromLatLngToDivPixel(this.latlng_);
                
                var div = this.div_;
                if (div) {
                    div.style.left = (position.x - 42) + 'px';
                    div.style.top = (position.y - 32) + 'px';
                }
            };

            CustomMarker.prototype.onRemove = function() {
                if (this.div_) {
                    this.div_.parentNode.removeChild(this.div_);
                    this.div_ = null;
                }
            };
        }

        // Initialize Google Map with dynamic geocoding fallback
        function initMap() {
            var mapElement = document.getElementById('properties-map');
            if (!mapElement || typeof google === 'undefined') return;

            infowindow = new google.maps.InfoWindow();

            map = new google.maps.Map(mapElement, {
                zoom: 12,
                center: { lat: 19.0760, lng: 72.8777 }, // Mumbai fallback
                mapTypeId: google.maps.MapTypeId.ROADMAP,
                streetViewControl: true,
                mapTypeControl: true,
                fullscreenControl: true
            });

            var geocoder = new google.maps.Geocoder();
            var index = 0;
            var bounds = new google.maps.LatLngBounds();

            function geocodeNext() {
                if (index >= mapProperties.length) {
                    // Set bounds once all coordinates are resolved
                    if (latlngs.length > 0) {
                        map.fitBounds(bounds);
                    }
                    return;
                }

                var prop = mapProperties[index];
                
                // Fallback coordinates
                var fallbackLatLng = new google.maps.LatLng(prop.dbLat, prop.dbLng);

                geocoder.geocode({ 'address': prop.address }, function(results, status) {
                    var resolvedLatLng = fallbackLatLng;

                    if (status === google.maps.GeocoderStatus.OK) {
                        resolvedLatLng = results[0].geometry.location;
                    }

                    prop.lat = resolvedLatLng.lat();
                    prop.lng = resolvedLatLng.lng();
                    latlngs.push(resolvedLatLng);
                    bounds.extend(resolvedLatLng);

                    // Add custom HTML price pin marker
                    var displayPrice = prop.price > 0 ? '₹' + prop.price.toLocaleString('en-IN') : 'Contact';
                    var markerHtml = '<div class="map-price-pin" id="marker-pin-' + prop.id + '">' +
                                        '<i class="fas fa-bed me-1" aria-hidden="true"></i>' +
                                        '<span>' + displayPrice + '</span>' +
                                     '</div>';

                    var customMarker = new CustomMarker(
                        resolvedLatLng, 
                        map, 
                        markerHtml, 
                        function() {
                            highlightCard(prop.id, false);
                            showInfoWindow(prop, resolvedLatLng);
                        },
                        prop.id
                    );

                    markers[prop.id] = customMarker;

                    index++;
                    // Delay execution slightly to prevent Google API rate limits
                    setTimeout(geocodeNext, 120);
                });
            }

            if (mapProperties.length > 0) {
                geocodeNext();
            }
        }

        // Show popup details in InfoWindow
        function showInfoWindow(prop, latlng) {
            var popupContent = '<div class="map-tooltip-dark" style="max-width:200px; font-family:\'Inter\', sans-serif;">' +
                                    '<img src="' + prop.image + '" style="width:100%; height:90px; object-fit:cover; border-radius:8px; margin-bottom:8px;" alt="' + prop.title + '">' +
                                    '<h6 style="margin:0 0 4px 0; font-weight:700; color:#111827; font-size:0.85rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + prop.title + '</h6>' +
                                    '<div style="font-weight:800; color:var(--ox-primary); font-size:0.9rem; margin-bottom:6px;">' + (prop.price > 0 ? '₹' + prop.price.toLocaleString('en-IN') + '/mo' : 'Contact') + '</div>' +
                                    '<a href="' + prop.slug + '" style="font-size:0.75rem; text-decoration:none; display:inline-flex; align-items:center; font-weight:700; color:var(--ox-primary);">View Stay &rarr;</a>' +
                                '</div>';

            infowindow.setContent(popupContent);
            infowindow.setPosition(latlng);
            // Offset a bit upwards to avoid overlaying the pin text
            infowindow.setOptions({ pixelOffset: new google.maps.Size(0, -35) });
            infowindow.open(map);
        }

        // Sync hover events from card to map pin
        function onCardHover(id) {
            var marker = markers[id];
            if (marker && marker.div_) {
                var pin = marker.div_.querySelector('.map-price-pin');
                if (pin) pin.classList.add('hovered');
            }
        }
        function onCardLeave(id) {
            var marker = markers[id];
            if (marker && marker.div_) {
                var pin = marker.div_.querySelector('.map-price-pin');
                if (pin) pin.classList.remove('hovered');
            }
        }

        // Highlight selected card and center map marker
        function highlightCard(id, shouldCenterMap) {
            $('.luxury-property-card').removeClass('active-highlight');
            var card = $('#property-card-' + id);
            if (card.length) {
                card.addClass('active-highlight');
                
                // Scroll listings panel smoothly to centered card
                var pane = $('.properties-listings-pane');
                pane.animate({
                    scrollTop: pane.scrollTop() + (card.position().top - pane.position().top) - 15
                }, 250);
            }

            $('.map-price-pin').removeClass('selected');
            var marker = markers[id];
            if (marker && marker.div_) {
                var pin = marker.div_.querySelector('.map-price-pin');
                if (pin) pin.classList.add('selected');
            }

            if (marker) {
                var latlng = marker.latlng_;
                var prop = mapProperties.find(p => p.id == id);
                if (prop) showInfoWindow(prop, latlng);
                
                if (shouldCenterMap && map) {
                    map.setCenter(latlng);
                    map.setZoom(16);
                }
            }
        }

        // Sync card clicks to map markers centering
        $(document).ready(function() {
            $('.luxury-property-card').on('click', function(e) {
                if (!$(e.target).closest('a').length && !$(e.target).closest('button').length) {
                    var cardId = $(this).attr('id').replace('property-card-', '');
                    highlightCard(cardId, true);
                }
            });
        });

        // Price Sorter Toggle
        var sortAsc = true;
        function toggleSort() {
            var grid = $('#listings-grid');
            var cards = grid.children('.listing-card-item').get();
            cards.sort(function(a, b) {
                var valA = parseInt($(a).attr('data-price')) || 0;
                var valB = parseInt($(b).attr('data-price')) || 0;
                return sortAsc ? (valA - valB) : (valB - valA);
            });
            $.each(cards, function(idx, item) {
                grid.append(item);
            });
            sortAsc = !sortAsc;
        }

        // Airbnb-style Mobile Map/List View Switcher
        function toggleMobileView() {
            var container = $('#split-container');
            var btn = $('#mobile-view-toggle');
            if (container.hasClass('show-list')) {
                container.removeClass('show-list').addClass('show-map');
                btn.html('<i class="fas fa-list" aria-hidden="true"></i> <span>Show List</span>');
                
                // Invalidate size to load map correctly on mobile
                setTimeout(function() {
                    if (map && latlngs.length > 0) {
                        google.maps.event.trigger(map, 'resize');
                        var bounds = new google.maps.LatLngBounds();
                        latlngs.forEach(function(latlng) { bounds.extend(latlng); });
                        map.fitBounds(bounds);
                    }
                }, 100);
            } else {
                container.removeClass('show-map').addClass('show-list');
                btn.html('<i class="fas fa-map" aria-hidden="true"></i> <span>Show Map</span>');
            }
        }

        // Run map init on DOM Load
        document.addEventListener('DOMContentLoaded', initMap);
    </script>
}
