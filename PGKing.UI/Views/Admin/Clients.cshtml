@model IEnumerable<PGKing.Application.Entities.PGRoom>
@{
    ViewData["Title"] = "Clients & Tenants";
    Layout = "_AdminLayout";

    var occupiedRooms = Model.Where(r => r.IsOccupied).ToList();
    var vacantRooms = Model.Where(r => !r.IsOccupied).ToList();
}

<div class="card border-0 shadow-sm rounded-4 animate-fade-in">
    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Clients & Tenant Management</h5>
            <p class="text-muted small mb-0">Assign clients to beds and manage their basic information.</p>
        </div>
    </div>
    <div class="card-body p-4 pt-0">
        <!-- Tabs Nav -->
        <ul class="nav nav-tabs mb-4 border-bottom-0 gap-2" id="clientsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill fw-bold border-0 px-4" id="current-tab" data-bs-toggle="tab" data-bs-target="#current" type="button" role="tab" style="background-color: transparent;">
                    <i class="fas fa-users me-2"></i> Current Tenants <span class="badge bg-primary ms-2 rounded-pill">@occupiedRooms.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold border-0 px-4" id="vacant-tab" data-bs-toggle="tab" data-bs-target="#vacant" type="button" role="tab" style="background-color: transparent;">
                    <i class="fas fa-bed me-2"></i> Vacant Beds <span class="badge bg-success ms-2 rounded-pill">@vacantRooms.Count</span>
                </button>
            </li>
        </ul>

        <!-- Tabs Content -->
        <div class="tab-content" id="clientsTabContent">
            
            <!-- CURRENT TENANTS TAB -->
            <div class="tab-pane fade show active" id="current" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-100 border-0 datatable">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 px-4">Client Information</th>
                                <th class="border-0">Contact Details</th>
                                <th class="border-0">Property & Bed</th>
                                <th class="border-0">Occupied Since</th>
                                <th class="border-0 text-end px-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in occupiedRooms)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px; font-weight: bold; font-size: 1.2rem;">
                                                @(string.IsNullOrEmpty(room.OccupiedByName) ? "?" : room.OccupiedByName.Substring(0,1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@room.OccupiedByName</div>
                                                @if (!string.IsNullOrEmpty(room.OccupiedByAadhar))
                                                {
                                                    <div class="text-muted small"><i class="fas fa-id-card me-1"></i> Aadhar: @room.OccupiedByAadhar</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark"><i class="fas fa-phone-alt me-1 text-muted"></i> @room.OccupiedByMobile</div>
                                        @if (!string.IsNullOrEmpty(room.OccupiedByEmail))
                                        {
                                            <div class="small text-muted"><i class="fas fa-envelope me-1"></i> @room.OccupiedByEmail</div>
                                        }
                                        @if (!string.IsNullOrEmpty(room.OccupiedByEmergencyContact))
                                        {
                                            <div class="small text-danger"><i class="fas fa-first-aid me-1"></i> Emg: @room.OccupiedByEmergencyContact</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold small text-dark">@room.Flat?.Property?.Title</div>
                                        <div class="text-muted small">@room.Flat?.Name - @room.SharingType</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            <i class="far fa-calendar-alt me-1 text-primary"></i> 
                                            @(room.OccupiedSince.HasValue ? room.OccupiedSince.Value.ToString("dd MMM yyyy") : "N/A")
                                        </span>
                                    </td>
                                    <td class="text-end px-4">
                                        <form asp-action="ReleaseClientFromBed" method="post" class="release-bed-form m-0">
                                            <input type="hidden" name="roomId" value="@room.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold shadow-sm">
                                                <i class="fas fa-user-minus me-1"></i> Release Bed
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- VACANT BEDS TAB -->
            <div class="tab-pane fade" id="vacant" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-100 border-0 datatable">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 px-4">Property Location</th>
                                <th class="border-0">Flat Name</th>
                                <th class="border-0">Bed / Sharing Type</th>
                                <th class="border-0">Rent / Deposit</th>
                                <th class="border-0 text-end px-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in vacantRooms)
                            {
                                <tr>
                                    <td class="px-4 fw-bold text-dark">
                                        <i class="fas fa-building text-primary me-2"></i> @room.Flat?.Property?.Title
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 rounded-pill small">@room.Flat?.BhkType</span>
                                        <span class="fw-semibold small ms-2">@room.Flat?.Name</span>
                                    </td>
                                    <td class="fw-semibold small text-dark">@room.SharingType</td>
                                    <td>
                                        <div class="small fw-bold">₹@room.Rent.ToString("N0") <span class="text-muted fw-normal">/mo</span></div>
                                        <div class="small text-muted">Dep: ₹@room.Deposit.ToString("N0")</div>
                                    </td>
                                    <td class="text-end px-4">
                                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm btn-assign-client"
                                                data-room-id="@room.Id"
                                                data-property-title="@room.Flat?.Property?.Title"
                                                data-flat-name="@room.Flat?.Name"
                                                data-sharing-type="@room.SharingType">
                                            <i class="fas fa-user-plus me-1"></i> Assign Client
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Assign Client to Bed Modal -->
<div class="modal fade" id="assignClientModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #0052FF, #00A3FF); color: white;">
                <h5 class="modal-title fw-bold"><i class="fas fa-user-plus me-2"></i> Assign Client to Bed</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert border-0 rounded-3 mb-4 py-3 px-4 d-flex align-items-center" style="background: rgba(0,82,255,0.07);">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm me-3" style="width: 40px; height: 40px;">
                        <i class="fas fa-bed text-primary"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;" id="assignModalPropertyFlat"></div>
                        <div class="text-muted small fw-semibold" id="assignModalSharingType"></div>
                    </div>
                </div>
                
                <form asp-action="AssignClientToBed" method="post">
                    <input type="hidden" name="roomId" id="assignModalRoomId" />
                    
                    <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">Client Basic Information</h6>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Full Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-user text-muted"></i></span>
                                <input type="text" name="clientName" class="form-control rounded-end-3" placeholder="Enter client full name" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Move-In Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-calendar-alt text-muted"></i></span>
                                <input type="date" name="moveInDate" id="assignModalMoveInDate" class="form-control rounded-end-3" />
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">Contact & Verification Details</h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Mobile Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-phone-alt text-muted"></i></span>
                                <input type="tel" name="clientMobile" class="form-control rounded-end-3" placeholder="10-digit mobile number" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-envelope text-muted"></i></span>
                                <input type="email" name="clientEmail" class="form-control rounded-end-3" placeholder="Enter email address" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Aadhar Number / ID Proof</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-id-card text-muted"></i></span>
                                <input type="text" name="clientAadhar" class="form-control rounded-end-3" placeholder="12-digit Aadhar or ID number" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Emergency Contact Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-first-aid text-muted"></i></span>
                                <input type="tel" name="emergencyContact" class="form-control rounded-end-3" placeholder="Emergency contact number" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Permanent Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-light"><i class="fas fa-home text-muted"></i></span>
                                <textarea name="permanentAddress" class="form-control rounded-end-3" rows="2" placeholder="Full permanent address"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-4">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm"><i class="fas fa-check me-2"></i>Assign Bed & Save Info</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Styling for Tabs */
    .nav-tabs .nav-link { color: #64748B; border-bottom: 2px solid transparent !important; }
    .nav-tabs .nav-link:hover { color: #1E293B; background: rgba(0,0,0,0.02) !important; }
    .nav-tabs .nav-link.active { color: #0052FF; border-bottom: 2px solid #0052FF !important; background: rgba(0, 82, 255, 0.05) !important; }
    
    /* DataTable Custom Styling to match theme */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input { border: 1px solid #E2E8F0; border-radius: 50px; padding: 6px 15px; font-size: 0.85rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: #0052FF !important; color: white !important; border: none !important; border-radius: 50px; }
    .dataTables_wrapper .dataTables_info { font-size: 0.85rem; color: #64748B; font-weight: 600; }
    table.dataTable thead th { border-bottom: 2px solid #F1F5F9 !important; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable({
                responsive: true,
                pageLength: 10,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search...",
                    lengthMenu: "Show _MENU_"
                }
            });
        });

        // Assign Client button click
        document.querySelectorAll('.btn-assign-client').forEach(button => {
            button.addEventListener('click', function() {
                const roomId = this.getAttribute('data-room-id');
                const propertyTitle = this.getAttribute('data-property-title');
                const flatName = this.getAttribute('data-flat-name');
                const sharingType = this.getAttribute('data-sharing-type');

                document.getElementById('assignModalRoomId').value = roomId;
                document.getElementById('assignModalPropertyFlat').innerText = propertyTitle + " - " + flatName;
                document.getElementById('assignModalSharingType').innerText = "Bed Type: " + sharingType;

                // Default move-in date to today
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('assignModalMoveInDate').value = today;

                new bootstrap.Modal(document.getElementById('assignClientModal')).show();
            });
        });

        // Release Bed confirmation
        document.querySelectorAll('.release-bed-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formEl = this;
                Swal.fire({
                    title: 'Release this Bed?',
                    text: "This will mark the bed as Available and remove the client details.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Release Bed',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        popup: 'rounded-4 border-0 shadow',
                        confirmButton: 'btn btn-warning px-4 rounded-pill fw-bold me-2',
                        cancelButton: 'btn btn-outline-secondary px-4 rounded-pill fw-bold'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) formEl.submit();
                });
            });
        });
    </script>
}
