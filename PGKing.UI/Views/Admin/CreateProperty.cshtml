@model PGKing.Application.Entities.Property
@{
    ViewData["Title"] = "Add New Property";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="fas fa-plus-circle text-primary me-2"></i> Create Property</h5>
                <p class="text-muted small">Select state and city to locate your property, then upload a cover photo.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateProperty" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Property Name</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. Navkar PG Vikhroli" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StateId" class="form-label fw-semibold">State</label>
                            <select asp-for="StateId" class="form-select rounded-3" asp-items="ViewBag.States" id="StateId" required>
                                <option value="">Select State</option>
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CityId" class="form-label fw-semibold">City</label>
                            <select asp-for="CityId" class="form-select rounded-3" id="CityId" required>
                                <option value="">Select City</option>
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">Street Address / Area</label>
                        <input asp-for="Address" class="form-control rounded-3" id="Address" placeholder="e.g. Near Station, Vikhroli East" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Property Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Describe your property, nearby locations, etc."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amenities</label>
                        <div class="row g-2">
                            @{
                                var allowedAmenities = new[] { 
                                    "Washing Machine", "Refrigerator", "Aqua Guard", "Geyser", "Wi-Fi", 
                                    "Cooking and Gas Connections", "Separate Almira", "Beds Matters", 
                                    "Pest control", "Housekeeping services" 
                                };
                            }
                            @foreach (var am in allowedAmenities)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input amenity-checkbox" type="checkbox" value="@am" id="am-@am.Replace(" ", "")">
                                        <label class="form-check-label small" for="am-@am.Replace(" ", "")">@am</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <input type="hidden" asp-for="Amenities" id="AmenitiesHidden" />
                        <span asp-validation-for="Amenities" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Upload Property Cover Photo</label>
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Properties" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Property & Continue</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="fw-bold"><i class="fas fa-map-marked-alt text-success me-2"></i>Location Preview</h5>
            </div>
            <div class="card-body">
                <div id="map-container" class="rounded-3 overflow-hidden shadow-sm" style="height: 350px; background: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                    <div id="map-placeholder" class="text-center p-4">
                        <i class="fas fa-map-marker-alt fs-1 text-muted mb-3"></i>
                        <p class="text-muted small mb-0">Enter the address to see the Google Map preview here.</p>
                    </div>
                    <iframe id="google-map" width="100%" height="100%" frameborder="0" style="border:0; display:none;" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#StateId').change(function () {
                var stateId = $(this).val();
                $('#CityId').empty();
                $('#CityId').append('<option value="">Select City</option>');
                if (stateId) {
                    $.getJSON('@Url.Action("GetCitiesByState")', { stateId: stateId }, function (cities) {
                        $.each(cities, function (i, city) {
                            $('#CityId').append('<option value="' + city.id + '">' + city.name + '</option>');
                        });
                        updateMap();
                    });
                } else { updateMap(); }
            });
            $('#Address, #CityId, #StateId').on('change keyup', function() { updateMap(); });
            
            $('form').submit(function() {
                var selected = [];
                $('.amenity-checkbox:checked').each(function() {
                    selected.push($(this).val());
                });
                $('#AmenitiesHidden').val(selected.join(','));
            });

            function updateMap() {
                var address = $('#Address').val();
                var city = $('#CityId option:selected').text();
                var state = $('#StateId option:selected').text();
                if (address && city !== "Select City" && state !== "Select State") {
                    var fullAddress = address + ", " + city + ", " + state;
                    var mapUrl = "https://maps.google.com/maps?q=" + encodeURIComponent(fullAddress) + "&t=&z=15&ie=UTF8&iwloc=&output=embed";
                    $('#map-placeholder').hide();
                    $('#google-map').attr('src', mapUrl).show();
                } else {
                    $('#google-map').hide();
                    $('#map-placeholder').show();
                }
            }
        });
    </script>
}
