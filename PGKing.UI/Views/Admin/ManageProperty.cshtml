@model PGKing.Application.Entities.Property
@{
    ViewData["Title"] = "Manage Property Hierarchy";
    Layout = "_AdminLayout";

    var roomAmenities = new string[] { 
        "Washing Machine", "Refrigerator", "Aqua Guard", "Geyser", "Wi-Fi", 
        "Cooking and Gas Connections", "Separate Almira", "Beds Matters", 
        "Pest control", "Housekeeping services" 
    };
}

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Properties" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i> Back to Properties</a>
</div>

<div class="row g-4">
    <!-- Property Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover; border-top-left-radius: 1rem; border-top-right-radius: 1rem;" />
            }
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1">@Model.Title</h4>
                <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt text-primary me-1"></i> @Model.Address</p>
                <hr class="opacity-25">
                
                <h6 class="fw-bold mb-3">Add Property Gallery</h6>
                <form asp-action="AddGalleryImages" method="post" enctype="multipart/form-data" class="mb-3">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="file" name="galleryFiles" class="form-control form-control-sm" multiple accept="image/*" required>
                        <button class="btn btn-primary btn-sm" type="submit">Upload</button>
                    </div>
                </form>
                
                <div class="row g-2">
                    @foreach (var m in Model.Media)
                    {
                        <div class="col-4 position-relative">
                            <img src="@m.FilePath" class="rounded w-100" style="height: 50px; object-fit: cover;" />
                            <form asp-action="DeletePropertyMedia" method="post" class="delete-form position-absolute top-0 end-0">
                                <input type="hidden" name="id" value="@m.Id" />
                                <input type="hidden" name="propertyId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger btn-xs p-0 px-1 rounded-circle border-0" style="font-size: 10px; transform: translate(5px, -5px);">&times;</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="col-lg-8">
        <!-- Add New Flat Form -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-plus-circle me-2"></i> Step 1: Add New Flat</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddFlat" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Flat Name / No.</label>
                            <input type="text" name="flatName" class="form-control rounded-3" placeholder="e.g. Flat 101, Suite A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Flat Type (BHK)</label>
                            <select name="bhkType" class="form-select rounded-3" required>
                                <option value="1 BHK">1 BHK</option>
                                <option value="2 BHK">2 BHK</option>
                                <option value="3 BHK">3 BHK</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Upload Flat Images & Videos (Hall, Kitchen, etc.)</label>
                            <input type="file" name="mediaFiles" class="form-control rounded-3" multiple accept="image/*,video/*" required />
                            <small class="text-muted">These photos will represent the entire flat unit.</small>
                        </div>
                        <div class="col-12 text-end mt-3">
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">Create Flat</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Existing Flats & Beds -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="fas fa-list text-primary me-2"></i> Step 2: Manage Flats & Beds</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Flats == null || !Model.Flats.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-building text-muted mb-3 fs-1 opacity-25"></i>
                        <p class="text-muted">No flats added yet. Start by adding a flat above.</p>
                    </div>
                }
                else
                {
                    foreach (var flat in Model.Flats)
                    {
                        <div class="flat-container mb-4 p-3 rounded-4 border border-light shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge bg-primary px-3 rounded-pill mb-1">@flat.BhkType</span>
                                    <h5 class="fw-bold mb-0">@flat.Name</h5>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <button class="btn btn-sm btn-success rounded-pill px-3" onclick="showAddBedForm(@flat.Id, '@flat.Name')"><i class="fas fa-plus me-1"></i> Add Bed</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 btn-edit-flat" 
                                            data-id="@flat.Id" 
                                            data-name="@flat.Name" 
                                            data-bhk="@flat.BhkType">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="DeleteFlat" method="post" class="delete-form m-0">
                                        <input type="hidden" name="id" value="@flat.Id" />
                                        <input type="hidden" name="propertyId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>

                            <!-- Flat Media Preview -->
                            <div class="row g-2 mb-3">
                                @foreach (var m in flat.Media)
                                {
                                    <div class="col-2 position-relative">
                                        <img src="@m.FilePath" class="rounded w-100" style="height: 50px; object-fit: cover;" />
                                        <form asp-action="DeleteFlatMedia" method="post" class="delete-form position-absolute top-0 end-0">
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <input type="hidden" name="propertyId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-danger btn-xs p-0 px-1 rounded-circle border-0" style="font-size: 10px; transform: translate(5px, -5px);">&times;</button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <!-- Add Flat Images Form -->
                            <form asp-action="AddFlatImages" method="post" enctype="multipart/form-data" class="mb-3">
                                <input type="hidden" name="flatId" value="@flat.Id" />
                                <input type="hidden" name="propertyId" value="@Model.Id" />
                                <div class="input-group input-group-sm mb-2" style="max-width: 450px;">
                                    <label class="input-group-text bg-light border-light-subtle small text-muted">Add Flat Images</label>
                                    <input type="file" name="flatFiles" class="form-control" multiple accept="image/*,video/*" required>
                                    <button class="btn btn-primary" type="submit">Upload</button>
                                </div>
                            </form>

                            <!-- Beds List in this Flat -->
                            <div class="bg-light rounded-4 p-3">
                                <h6 class="fw-bold small mb-3 text-muted">Bed / Sharing Configurations:</h6>
                                @if (flat.Rooms == null || !flat.Rooms.Any())
                                {
                                    <p class="small text-muted mb-0">No beds added to this flat yet.</p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                            <thead class="text-muted small">
                                                <tr>
                                                    <th>Sharing Type</th>
                                                    <th>Rent</th>
                                                    <th>Deposit</th>
                                                    <th>Amenities</th>
                                                    <th>Tenant</th>
                                                    <th>Status</th>
                                                    <th class="text-end">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var room in flat.Rooms)
                                                {
                                                    <tr>
                                                        <td class="fw-bold small">@room.SharingType</td>
                                                        <td class="small">₹@room.Rent.ToString("N0")</td>
                                                        <td class="small">₹@room.Deposit.ToString("N0")</td>
                                                        <td>
                                                            @foreach (var am in room.Amenities.Split(','))
                                                            {
                                                                <span class="badge bg-white text-dark border small fw-normal" style="font-size: 9px;">@am</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (room.IsOccupied && !string.IsNullOrEmpty(room.OccupiedByName))
                                                            {
                                                                <div>
                                                                    <div class="fw-bold small text-dark">@room.OccupiedByName</div>
                                                                    <div class="small text-muted"><i class="fas fa-phone-alt" style="font-size:9px;"></i> @room.OccupiedByMobile</div>
                                                                    @if (room.OccupiedSince.HasValue)
                                                                    {
                                                                        <div class="small text-muted"><i class="fas fa-calendar-alt" style="font-size:9px;"></i> Since @room.OccupiedSince.Value.ToString("dd MMM yyyy")</div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size:9px;">— Vacant —</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (room.IsOccupied)
                                                            {
                                                                <span class="badge bg-danger px-2 py-1 rounded-pill" style="font-size:9px;"><i class="fas fa-circle me-1" style="font-size:6px;"></i>Occupied</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success px-2 py-1 rounded-pill" style="font-size:9px;"><i class="fas fa-circle me-1" style="font-size:6px;"></i>Available</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <div class="d-flex justify-content-end align-items-center gap-2">
                                                                <a asp-action="Clients" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size:10px;">
                                                                    <i class="fas fa-user-cog me-1"></i>Manage Client
                                                                </a>
                                                                <button type="button" 
                                                                        class="btn btn-link text-primary p-0 btn-edit-room" 
                                                                        data-id="@room.Id" 
                                                                        data-sharing-type="@room.SharingType" 
                                                                        data-rent="@room.Rent" 
                                                                        data-deposit="@room.Deposit" 
                                                                        data-amenities="@room.Amenities">
                                                                    <i class="fas fa-edit"></i>
                                                                </button>
                                                                <form asp-action="DeleteRoom" method="post" class="delete-form m-0">
                                                                    <input type="hidden" name="id" value="@room.Id" />
                                                                    <input type="hidden" name="propertyId" value="@Model.Id" />
                                                                    <button type="submit" class="btn btn-link text-danger p-0"><i class="fas fa-times"></i></button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Bed Modal -->
<div class="modal fade" id="addBedModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-bed me-2"></i> Add Bed Configuration - <span id="modalFlatName"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="AddRoom" method="post">
                    <input type="hidden" name="FlatId" id="modalFlatId" />
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-bold small">Sharing / Bed Type</label>
                            <input type="text" name="SharingType" class="form-control rounded-3" placeholder="e.g. Master Bedroom Double Sharing" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Monthly Rent (₹)</label>
                            <input type="number" name="Rent" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Deposit (₹)</label>
                            <input type="number" name="Deposit" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small d-block mb-3">Room Amenities</label>
                        <div class="row g-2">
                            
                            @foreach (var am in roomAmenities)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedAmenities" value="@am" id="am_@am.Replace(" ", "_")">
                                        <label class="form-check-label small" for="am_@am.Replace(" ", "_")">@am</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success px-5 rounded-pill fw-bold">Save Bed Detail</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<!-- Edit Bed Modal -->
<div class="modal fade" id="editBedModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i> Edit Bed Configuration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="EditRoom" method="post">
                    <input type="hidden" name="Id" id="editModalRoomId" />
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-bold small">Sharing / Bed Type</label>
                            <input type="text" name="SharingType" id="editModalSharingType" class="form-control rounded-3" placeholder="e.g. Master Bedroom Double Sharing" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Monthly Rent (₹)</label>
                            <input type="number" name="Rent" id="editModalRent" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Deposit (₹)</label>
                            <input type="number" name="Deposit" id="editModalDeposit" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small d-block mb-3">Room Amenities</label>
                        <div class="row g-2">
                            @foreach (var am in roomAmenities)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedAmenities" value="@am" id="edit_am_@am.Replace(" ", "_")">
                                        <label class="form-check-label small" for="edit_am_@am.Replace(" ", "_")">@am</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold">Update Bed Detail</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Flat Modal -->
<div class="modal fade" id="editFlatModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i> Edit Flat</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="EditFlat" method="post">
                    <input type="hidden" name="Id" id="editFlatModalId" />
                    <input type="hidden" name="PropertyId" value="@Model.Id" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small">Flat Name / No.</label>
                            <input type="text" name="Name" id="editFlatModalName" class="form-control rounded-3" placeholder="e.g. Flat 101, Suite A" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Flat Type (BHK)</label>
                            <select name="BhkType" id="editFlatModalBhk" class="form-select rounded-3" required>
                                <option value="1 BHK">1 BHK</option>
                                <option value="2 BHK">2 BHK</option>
                                <option value="3 BHK">3 BHK</option>
                            </select>
                        </div>
                        <div class="col-12 text-end mt-4">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold">Update Flat</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function showAddBedForm(flatId, flatName) {
        document.getElementById('modalFlatId').value = flatId;
        document.getElementById('modalFlatName').innerText = flatName;
        new bootstrap.Modal(document.getElementById('addBedModal')).show();
    }


    document.querySelectorAll('.btn-edit-room').forEach(button => {
        button.addEventListener('click', function() {
            const roomId = this.getAttribute('data-id');
            const sharingType = this.getAttribute('data-sharing-type');
            const rent = this.getAttribute('data-rent');
            const deposit = this.getAttribute('data-deposit');
            const amenitiesStr = this.getAttribute('data-amenities') || '';
            const amenities = amenitiesStr.split(',').map(a => a.trim());

            document.getElementById('editModalRoomId').value = roomId;
            document.getElementById('editModalSharingType').value = sharingType;
            document.getElementById('editModalRent').value = rent;
            document.getElementById('editModalDeposit').value = deposit;

            // Reset and check matching checkboxes
            const checkboxes = document.querySelectorAll('#editBedModal input[type="checkbox"]');
            checkboxes.forEach(cb => {
                cb.checked = amenities.includes(cb.value);
            });

            new bootstrap.Modal(document.getElementById('editBedModal')).show();
        });
    });

    document.querySelectorAll('.btn-edit-flat').forEach(button => {
        button.addEventListener('click', function() {
            const flatId = this.getAttribute('data-id');
            const flatName = this.getAttribute('data-name');
            const bhkType = this.getAttribute('data-bhk');

            document.getElementById('editFlatModalId').value = flatId;
            document.getElementById('editFlatModalName').value = flatName;
            document.getElementById('editFlatModalBhk').value = bhkType;

            new bootstrap.Modal(document.getElementById('editFlatModal')).show();
        });
    });

    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formElement = this;
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'rounded-4 border-0 shadow',
                    confirmButton: 'btn btn-danger px-4 rounded-pill fw-bold me-2',
                    cancelButton: 'btn btn-outline-secondary px-4 rounded-pill fw-bold'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    formElement.submit();
                }
            });
        });
    });
</script>
