@model IEnumerable<PGKing.Application.Entities.Property>
@{
    ViewData["Title"] = "Properties Management";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">All Properties</h5>
        <a asp-action="CreateProperty" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> Add Property</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Property Name</th>
                        <th>Location</th>
                        <th>Total Rooms</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if(!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-building text-primary"></i>
                                            </div>
                                        }
                                        <span class="fw-semibold">@item.Title</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@item.City?.Name, @item.State?.Name</div>
                                    <div class="small text-muted">@item.Address</div>
                                </td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">@item.Rooms?.Count Rooms</span></td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="ManageProperty" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Manage Rooms"><i class="fas fa-cog"></i></a>
                                        <a asp-action="EditProperty" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mx-1" title="Edit Property"><i class="fas fa-edit"></i></a>
                                        <button class="btn btn-sm btn-outline-danger" title="Delete Property"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fs-2 mb-2 d-block"></i>
                                No properties found. Click "Add Property" to create one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
