@model IEnumerable<PGKing.Application.Entities.Property>
@{
    ViewData["Title"] = "Properties Management";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm rounded-4 animate-fade-in">
    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Properties Inventory</h5>
            <p class="text-muted small mb-0">Manage your locations, rooms, and media galleries.</p>
        </div>
        <a asp-action="CreateProperty" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> Add Property
        </a>
    </div>
    <div class="card-body p-4 pt-0">
        <div class="table-responsive">
            <table id="propertiesTable" class="table table-hover align-middle w-100 border-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 px-4">Property Identity</th>
                        <th class="border-0">Location</th>
                        <th class="border-0 text-center">Capacity</th>
                        <th class="border-0 text-end px-4">Management</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center">
                                        <div class="position-relative me-3">
                                            @if(!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" class="rounded-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary-soft rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; background: rgba(0, 82, 255, 0.08);">
                                                    <i class="fas fa-building text-primary"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                @item.Title
                                                @if(item.IsVerified)
                                                {
                                                    <span class="badge bg-light text-primary border px-2 py-0" style="font-size: 0.65rem;"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                                }
                                            </div>
                                            <div class="text-muted small">
                                                ID: #PG-@item.Id <span class="badge bg-light text-secondary ms-1">@item.PgType</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold small text-dark">@item.City?.Name, @item.State?.Name</div>
                                    <div class="text-muted small">@item.Address</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var totalBeds = item.Flats?.SelectMany(f => f.Rooms).Count() ?? 0;
                                        var occupiedBeds = item.Flats?.SelectMany(f => f.Rooms).Count(r => r.IsOccupied) ?? 0;
                                    }
                                    <div class="badge bg-light text-primary border px-3 py-2 rounded-pill fw-bold" style="font-size: 0.7rem;">
                                        <i class="fas fa-bed me-1"></i> @occupiedBeds/@totalBeds Occupied
                                    </div>
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="ManageProperty" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold shadow-sm" title="Manage Rooms">
                                            <i class="fas fa-sliders-h me-1 text-primary"></i> Rooms
                                        </a>
                                        <a asp-action="EditProperty" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold shadow-sm" title="Edit Property">
                                            <i class="fas fa-edit me-1 text-warning"></i> Edit
                                        </a>
                                        <form id="delete-form-@item.Id" asp-action="DeleteProperty" method="post" style="display:none;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                        </form>
                                        <button class="btn btn-sm btn-light border rounded-pill px-2 fw-bold shadow-sm text-danger" onclick="confirmDelete(@item.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* DataTable Custom Styling to match theme */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #E2E8F0;
        border-radius: 50px;
        padding: 6px 15px;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #0052FF !important;
        color: white !important;
        border: none !important;
        border-radius: 50px;
    }
    .dataTables_wrapper .dataTables_info { font-size: 0.85rem; color: #64748B; font-weight: 600; }
    table.dataTable thead th { border-bottom: 2px solid #F1F5F9 !important; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#propertiesTable').DataTable({
                responsive: true,
                order: [[0, 'asc']],
                pageLength: 10,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search properties...",
                    lengthMenu: "Show _MENU_"
                }
            });
        });

        function confirmDelete(id) {
            if(confirm('Are you sure you want to delete this property? This action cannot be undone.')) {
                document.getElementById('delete-form-' + id).submit();
            }
        }
    </script>
}
