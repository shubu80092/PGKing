@model PGKing.Application.Entities.Banner
@{
    ViewData["Title"] = "Edit Banner";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="fas fa-edit text-primary me-2"></i> Edit Homepage Banner</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditBanner" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Banner Title</label>
                        <input asp-for="Title" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="SubTitle" class="form-label fw-semibold">Banner Subtitle</label>
                        <textarea asp-for="SubTitle" class="form-control rounded-3" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6 mb-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label fw-semibold" asp-for="IsActive">Show on Homepage</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Change Banner Image</label>
                        <div class="d-flex align-items-center mb-2">
                            <img src="@Model.ImageUrl" class="rounded me-3" style="width: 150px; height: 75px; object-fit: cover;" />
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        </div>
                        <div class="form-text small">Leave empty to keep the current image.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Banners" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Update Banner</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
