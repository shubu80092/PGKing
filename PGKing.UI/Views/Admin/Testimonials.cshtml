@model IEnumerable<PGKing.Application.Entities.Testimonial>
@{
    ViewData["Title"] = "Manage Testimonials";
    Layout = "_AdminLayout";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Testimonials</h2>
            <p class="text-muted mb-0">Manage client reviews and testimonials.</p>
        </div>
        <a asp-action="CreateTestimonial" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus me-2"></i> Add Testimonial
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">Client</th>
                            <th class="py-3">Designation</th>
                            <th class="py-3">Message</th>
                            <th class="py-3">Rating</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Order</th>
                            <th class="text-end px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded-circle me-3 border" style="width: 48px; height: 48px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary-soft text-primary d-flex align-items-center justify-content-center me-3 fw-bold border" style="width: 48px; height: 48px;">
                                                @item.Name.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div class="fw-bold text-dark">@item.Name</div>
                                    </div>
                                </td>
                                <td class="py-3 text-muted">@item.Designation</td>
                                <td class="py-3 text-muted">
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.Message">
                                        @item.Message
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="text-warning">
                                        @for (int i = 0; i < item.Rating; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger") bg-opacity-10 text-@(item.IsActive ? "success" : "danger") rounded-pill px-3 py-2">
                                        @(item.IsActive ? "Active" : "Hidden")
                                    </span>
                                </td>
                                <td class="py-3">@item.DisplayOrder</td>
                                <td class="text-end px-4 py-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="EditTestimonial" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold shadow-sm">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                        <form asp-action="DeleteTestimonial" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this testimonial?')">
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-sm">
                                                <i class="fas fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="mb-3"><i class="fas fa-comment-dots fs-1 text-gray-300"></i></div>
                                    <h6>No testimonials found</h6>
                                    <p class="small mb-0">Click "Add Testimonial" to create one.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
