@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "_AdminLayout";
}

<div class="row g-4 animate-fade-in">
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon icon-primary">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <p class="dashboard-stat-title">Total Properties</p>
                <h3 class="dashboard-stat-value">@ViewBag.PropertiesCount</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon icon-success">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <p class="dashboard-stat-title">Active Tenants</p>
                <h3 class="dashboard-stat-value">124</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon icon-warning">
                <i class="fas fa-bed"></i>
            </div>
            <div>
                <p class="dashboard-stat-title">Available Beds</p>
                <h3 class="dashboard-stat-value">48</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon" style="background: #FEF2F2; color: #EF4444;">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <p class="dashboard-stat-title">Revenue (Monthly)</p>
                <h3 class="dashboard-stat-value">₹ 4.2L</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 col-xl-8 mb-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold">Recent Bookings</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tenant Name</th>
                                <th>Property</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><img src="https://ui-avatars.com/api/?name=Rahul+Kumar&background=random" width="32" class="rounded-circle me-2"> Rahul Kumar</td>
                                <td>Navkar PG Vikhroli</td>
                                <td>Oct 24, 2023</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Confirmed</span></td>
                            </tr>
                            <tr>
                                <td><img src="https://ui-avatars.com/api/?name=Priya+Sharma&background=random" width="32" class="rounded-circle me-2"> Priya Sharma</td>
                                <td>Orchid Girls Hostel</td>
                                <td>Oct 23, 2023</td>
                                <td><span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Pending</span></td>
                            </tr>
                            <tr>
                                <td><img src="https://ui-avatars.com/api/?name=Amit+Patel&background=random" width="32" class="rounded-circle me-2"> Amit Patel</td>
                                <td>Signature Boy's PG</td>
                                <td>Oct 21, 2023</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Confirmed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-xl-4 mb-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold">Occupancy Rate</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <!-- Circular Progress Bar Placeholder -->
                <div class="position-relative d-inline-block">
                    <svg width="160" height="160" viewBox="0 0 160 160">
                        <circle cx="80" cy="80" r="70" fill="none" stroke="#F3F4F6" stroke-width="15" />
                        <circle cx="80" cy="80" r="70" fill="none" stroke="var(--primary)" stroke-width="15" stroke-dasharray="440" stroke-dashoffset="110" stroke-linecap="round" transform="rotate(-90 80 80)" />
                    </svg>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <h2 class="fw-bold mb-0 text-dark">75%</h2>
                        <small class="text-muted">Occupied</small>
                    </div>
                </div>
                <div class="d-flex w-100 justify-content-between mt-4 text-center">
                    <div>
                        <h6 class="mb-0 fw-bold">124</h6>
                        <small class="text-muted">Occupied Beds</small>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">48</h6>
                        <small class="text-muted">Available Beds</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
