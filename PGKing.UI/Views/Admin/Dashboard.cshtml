@model List<PGKing.Application.Entities.Booking>
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "_AdminLayout";
    
    var totalBeds = (int)ViewBag.TotalBeds;
    var occupiedBeds = (int)ViewBag.OccupiedBeds;
    var availableBeds = (int)ViewBag.AvailableBeds;
    var occupancyRate = totalBeds > 0 ? (int)((double)occupiedBeds / totalBeds * 100) : 0;
}

<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card shadow-sm border-0 animate-fade-in">
            <div class="dashboard-icon icon-primary">
                <i class="fas fa-building-user"></i>
            </div>
            <div>
                <p class="dashboard-stat-title text-muted">Properties</p>
                <h3 class="dashboard-stat-value">@ViewBag.PropertiesCount</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card shadow-sm border-0 animate-fade-in" style="animation-delay: 0.1s">
            <div class="dashboard-icon icon-success">
                <i class="fas fa-house-chimney-user"></i>
            </div>
            <div>
                <p class="dashboard-stat-title text-muted">Total Flats</p>
                <h3 class="dashboard-stat-value">@ViewBag.FlatsCount</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card shadow-sm border-0 animate-fade-in" style="animation-delay: 0.2s">
            <div class="dashboard-icon icon-warning">
                <i class="fas fa-bed-pulse"></i>
            </div>
            <div>
                <p class="dashboard-stat-title text-muted">Available Beds</p>
                <h3 class="dashboard-stat-value text-success">@availableBeds</h3>
                <small class="text-muted fw-bold" style="font-size: 0.65rem;">CAPACITY: @totalBeds</small>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3">
        <div class="dashboard-card shadow-sm border-0 animate-fade-in" style="animation-delay: 0.3s">
            <div class="dashboard-icon" style="background: rgba(239, 68, 68, 0.08); color: #EF4444;">
                <i class="fas fa-chart-line"></i>
            </div>
            <div>
                <p class="dashboard-stat-title text-muted">Monthly Revenue</p>
                <h3 class="dashboard-stat-value">₹ @(((decimal)ViewBag.MonthlyRevenue).ToString("N0"))</h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Booking Trends Chart -->
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm rounded-4 animate-fade-in">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Booking Trends (Last 7 Days)</h5>
            </div>
            <div class="card-body p-4" style="height: 300px;">
                <canvas id="bookingTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-xl-8 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 animate-fade-in">
            <div class="card-header bg-white border-0 p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Activity</h5>
                    <a asp-action="Bookings" class="btn btn-sm btn-light rounded-pill px-3 fw-bold border">View All</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 border-0">User</th>
                                <th class="py-3 border-0">Stay Details</th>
                                <th class="py-3 border-0">Date</th>
                                <th class="py-3 border-0">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var booking in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary-soft rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                                    <i class="fas fa-user text-primary"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@booking.FullName</div>
                                                    <div class="text-muted small">@booking.MobileNumber</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div class="fw-semibold small">@booking.Property?.Title</div>
                                            <div class="text-muted small">ID: #BK-@booking.Id</div>
                                        </td>
                                        <td class="py-3"><span class="text-muted small fw-bold">@booking.CreatedAt.ToString("MMM dd, HH:mm")</span></td>
                                        <td class="py-3">
                                            @if (booking.Status == "Pending")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">PENDING</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">CONFIRMED</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="opacity-25 mb-3"><i class="fas fa-inbox fs-1"></i></div>
                                        <p class="text-muted fw-bold">No active logs found.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Occupancy Meter -->
    <div class="col-xl-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 animate-fade-in" style="animation-delay: 0.2s">
            <div class="card-header bg-white border-0 p-4 text-center">
                <h5 class="fw-bold mb-0">Occupancy Meter</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center p-4">
                <div class="position-relative d-inline-block mb-4" style="width: 200px; height: 200px;">
                    <canvas id="occupancyDoughnut"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none;">
                        <h2 class="fw-bold mb-0 text-dark" style="font-size: 2rem;">@occupancyRate%</h2>
                        <p class="text-muted fw-bold mb-0" style="font-size: 0.7rem; letter-spacing: 1px;">OCCUPIED</p>
                    </div>
                </div>
                
                <div class="w-100 px-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-bold text-muted">Full Beds</span>
                        <span class="small fw-bold text-primary">@occupiedBeds / @totalBeds</span>
                    </div>
                    <div class="progress rounded-pill mb-4" style="height: 10px;">
                        <div class="progress-bar bg-primary rounded-pill" style="width: @occupancyRate%"></div>
                    </div>
                    
                    <div class="bg-primary-soft p-3 rounded-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="bg-success rounded-circle me-2" style="width: 10px; height: 10px;"></div>
                                <span class="small fw-bold text-dark">Ready to Move</span>
                            </div>
                            <span class="badge bg-success px-2 py-1">@availableBeds</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bed Availability by Property -->
@{
    var propertyBedStats = ViewBag.PropertyBedStats as IEnumerable<dynamic>;
}
@if (propertyBedStats != null && propertyBedStats.Any())
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 animate-fade-in" style="animation-delay: 0.3s">
        <div class="card-body p-4 border-bottom">
            <div style="height: 250px;">
                <canvas id="propertyBarChart"></canvas>
            </div>
        </div>
        <div class="card-header bg-white border-0 p-4 pt-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1"><i class="fas fa-building-user text-primary me-2"></i>Bed Availability by Property</h5>
                    <p class="text-muted small mb-0">Real-time occupancy status per property</p>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span class="d-flex align-items-center gap-1 small fw-bold text-success"><span style="width:10px;height:10px;border-radius:50%;background:#22C55E;display:inline-block;"></span>Available</span>
                    <span class="d-flex align-items-center gap-1 small fw-bold text-danger"><span style="width:10px;height:10px;border-radius:50%;background:#EF4444;display:inline-block;"></span>Occupied</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0 pb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 border-0">Property</th>
                            <th class="py-3 border-0 text-center">Total Beds</th>
                            <th class="py-3 border-0 text-center">Occupied</th>
                            <th class="py-3 border-0 text-center">Available</th>
                            <th class="py-3 border-0" style="min-width:180px;">Occupancy Rate</th>
                            <th class="py-3 border-0 text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in propertyBedStats)
                        {
                            int totalB = (int)stat.TotalBeds;
                            int occupiedB = (int)stat.OccupiedBeds;
                            int availableB = totalB - occupiedB;
                            int rateB = totalB > 0 ? (int)((double)occupiedB / totalB * 100) : 0;
                            string barColor = rateB >= 80 ? "#EF4444" : rateB >= 50 ? "#F59E0B" : "#22C55E";
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:rgba(0,82,255,0.08);">
                                            <i class="fas fa-building text-primary" style="font-size:14px;"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">@stat.PropertyName</div>
                                            <div class="text-muted" style="font-size:0.7rem;">ID: #@stat.PropertyId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-bold">@totalB</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge fw-bold px-3 py-2 rounded-pill" style="background:rgba(239,68,68,0.1);color:#EF4444;font-size:0.7rem;">@occupiedB</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge fw-bold px-3 py-2 rounded-pill" style="background:rgba(34,197,94,0.1);color:#22C55E;font-size:0.7rem;">@availableB</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1 rounded-pill" style="height:8px;">
                                            <div class="progress-bar rounded-pill" style="width:@rateB%;background:@barColor;transition:width 1s ease;"></div>
                                        </div>
                                        <span class="small fw-bold" style="min-width:35px;color:@barColor;">@rateB%</span>
                                    </div>
                                </td>
                                <td class="text-end px-4">
                                    <a asp-action="ManageProperty" asp-route-id="@stat.PropertyId" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" style="font-size:0.75rem;">
                                        <i class="fas fa-eye me-1"></i>Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeInUp 0.6s ease forwards; opacity: 0; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Shared Chart.js Defaults
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#8E8A84';
            
            // 1. Booking Trends Line Chart
            const trendCtx = document.getElementById('bookingTrendChart');
            if (trendCtx) {
                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(ViewBag.TrendLabelsJson ?? "[]"),
                        datasets: [{
                            label: 'New Bookings',
                            data: @Html.Raw(ViewBag.TrendDataJson ?? "[]"),
                            borderColor: '#0052FF',
                            backgroundColor: 'rgba(0, 82, 255, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#0052FF',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { borderDash: [5, 5], color: '#f1f5f9' }, ticks: { stepSize: 1 } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // 2. Occupancy Doughnut Chart
            const occCtx = document.getElementById('occupancyDoughnut');
            if (occCtx) {
                new Chart(occCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Occupied', 'Available'],
                        datasets: [{
                            data: [@occupiedBeds, @availableBeds],
                            backgroundColor: ['#0052FF', '#F1F5F9'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: { legend: { display: false }, tooltip: { enabled: true } }
                    }
                });
            }

            // 3. Property Occupancy Bar Chart
            const barCtx = document.getElementById('propertyBarChart');
            if (barCtx) {
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(ViewBag.PropertyLabelsJson ?? "[]"),
                        datasets: [
                            {
                                label: 'Occupied Beds',
                                data: @Html.Raw(ViewBag.PropertyOccupiedBedsJson ?? "[]"),
                                backgroundColor: '#0052FF',
                                borderRadius: 4,
                                categoryPercentage: 0.6,
                                barPercentage: 0.8
                            },
                            {
                                label: 'Total Beds',
                                data: @Html.Raw(ViewBag.PropertyTotalBedsJson ?? "[]"),
                                backgroundColor: '#E2E8F0',
                                borderRadius: 4,
                                categoryPercentage: 0.6,
                                barPercentage: 0.8
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 8 } }
                        },
                        scales: {
                            y: { beginAtZero: true, grid: { borderDash: [5, 5], color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        });
    </script>
}
