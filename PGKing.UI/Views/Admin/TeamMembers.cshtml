@model IEnumerable<PGKing.Application.Entities.TeamMember>
@{
    ViewData["Title"] = "Team Management";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm rounded-4 animate-fade-in">
    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Company Team Members</h5>
            <p class="text-muted small mb-0">Manage the corporate office team members and details shown on the website.</p>
        </div>
        <a asp-action="CreateTeamMember" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> Add New Member
        </a>
    </div>
    <div class="card-body p-4 pt-0">
        <div class="table-responsive">
            <table id="teamTable" class="table table-hover align-middle w-100 border-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 px-4" style="width: 80px;">Order</th>
                        <th class="border-0">Photo</th>
                        <th class="border-0">Name & Designation</th>
                        <th class="border-0">Contact details</th>
                        <th class="border-0 text-center">Status</th>
                        <th class="border-0 text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="bg-light rounded-circle fw-bold text-dark d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-size: 0.8rem;">
                                        @item.DisplayOrder
                                    </div>
                                </td>
                                <td>
                                    <img src="@item.ImageUrl" class="rounded-circle shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="text-primary small fw-semibold text-uppercase">@item.Designation</div>
                                </td>
                                <td>
                                    <div class="small mb-1"><i class="fas fa-envelope me-1 text-muted"></i> @item.Email</div>
                                    @if (!string.IsNullOrEmpty(item.LinkedInUrl))
                                    {
                                        <div class="small"><i class="fab fa-linkedin me-1 text-muted"></i> <a href="@item.LinkedInUrl" target="_blank" class="text-decoration-none">Profile</a></div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if(item.IsActive) {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">ACTIVE</span>
                                    } else {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">HIDDEN</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="EditTeamMember" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold shadow-sm">
                                            <i class="fas fa-edit me-1 text-warning"></i> Edit
                                        </a>
                                        <form asp-action="DeleteTeamMember" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this team member?')">
                                            <button type="submit" class="btn btn-sm btn-light border rounded-pill px-2 fw-bold shadow-sm text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #E2E8F0;
        border-radius: 50px;
        padding: 6px 15px;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #0052FF !important;
        color: white !important;
        border: none !important;
        border-radius: 50px;
    }
    .dataTables_wrapper .dataTables_info { font-size: 0.85rem; color: #64748B; font-weight: 600; }
    table.dataTable thead th { border-bottom: 2px solid #F1F5F9 !important; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#teamTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search members..."
                }
            });
        });
    </script>
}
