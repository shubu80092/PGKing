@model IEnumerable<PGKing.Application.Entities.ContactInquiry>
@{
    ViewData["Title"] = "Contact Inquiries";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm rounded-4 animate-fade-in">
    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Customer Inquiries</h5>
            <p class="text-muted small mb-0">Manage customer inquiries received from the website Contact page.</p>
        </div>
    </div>
    <div class="card-body p-4 pt-0">
        <div class="table-responsive">
            <table id="inquiriesTable" class="table table-hover align-middle w-100 border-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 px-4" style="width: 140px;">Date</th>
                        <th class="border-0">Name</th>
                        <th class="border-0">Phone</th>
                        <th class="border-0">Email</th>
                        <th class="border-0">Message</th>
                        <th class="border-0 text-center" style="width: 100px;">Status</th>
                        <th class="border-0 text-end px-4" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsRead ? "" : "table-light fw-bold")">
                                <td class="px-4">
                                    <div class="small">@item.CreatedAt.ToString("g")</div>
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Phone</td>
                                <td>@item.Email</td>
                                <td>
                                    <div class="text-muted small text-truncate" style="max-width: 250px;" title="@item.Message">
                                        @item.Message
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if(item.IsRead) {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">READ</span>
                                    } else {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-bold" style="font-size: 0.65rem;">NEW</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if(!item.IsRead) {
                                            <form asp-action="MarkInquiryAsRead" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-light border rounded-pill px-3 fw-bold shadow-sm">
                                                    <i class="fas fa-check text-success me-1"></i> Read
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="DeleteInquiry" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this inquiry?')">
                                            <button type="submit" class="btn btn-sm btn-light border rounded-pill px-2 fw-bold shadow-sm text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #E2E8F0;
        border-radius: 50px;
        padding: 6px 15px;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #0052FF !important;
        color: white !important;
        border: none !important;
        border-radius: 50px;
    }
    .dataTables_wrapper .dataTables_info { font-size: 0.85rem; color: #64748B; font-weight: 600; }
    table.dataTable thead th { border-bottom: 2px solid #F1F5F9 !important; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#inquiriesTable').DataTable({
                responsive: true,
                order: [[0, "desc"]],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search inquiries..."
                }
            });
        });
    </script>
}
