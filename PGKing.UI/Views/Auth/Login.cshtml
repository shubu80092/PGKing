@{
    ViewData["Title"] = "Admin Login";
    Layout = null; // No layout to make it a standalone full-screen login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SuperAdmin Login - PGKing</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }
        .login-card {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-radius: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
            padding: 0.5rem;
        }
        .login-header {
            background: transparent;
            padding: 2.5rem 2rem 1.5rem 2rem;
            text-align: center;
        }
        .login-logo {
            height: 140px;
            width: auto;
            object-fit: contain;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .login-logo:hover {
            transform: scale(1.05);
        }
        .login-body {
            padding: 1.5rem 2rem 2.5rem 2rem;
        }
        .form-label {
            color: #e2e8f0;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }
        .input-group-text {
            background-color: rgba(30, 41, 59, 0.5) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #94a3b8 !important;
            border-top-left-radius: 0.75rem !important;
            border-bottom-left-radius: 0.75rem !important;
        }
        .form-control {
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            background-color: rgba(30, 41, 59, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
            font-size: 0.95rem;
        }
        .form-control::placeholder {
            color: #64748b;
            opacity: 1;
        }
        .form-control:focus {
            background-color: rgba(30, 41, 59, 0.6) !important;
            box-shadow: 0 0 0 3px rgba(0, 82, 255, 0.25) !important;
            border-color: #0052FF !important;
            color: #ffffff !important;
        }
        .btn-eye {
            background-color: rgba(30, 41, 59, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            border-top-right-radius: 0.75rem !important;
            border-bottom-right-radius: 0.75rem !important;
            color: #94a3b8 !important;
            transition: color 0.2s;
        }
        .btn-eye:hover {
            color: #ffffff !important;
        }
        .btn-primary {
            background-color: #0052FF !important;
            border: none !important;
            border-radius: 0.75rem !important;
            padding: 0.85rem !important;
            font-weight: 600 !important;
            letter-spacing: 0.05em;
            box-shadow: 0 4px 12px rgba(0, 82, 255, 0.3) !important;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        .btn-primary:hover {
            background-color: #0041CC !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 82, 255, 0.45) !important;
        }
        .btn-primary:active {
            transform: translateY(0);
        }
        .form-check-input {
            background-color: rgba(30, 41, 59, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
        }
        .form-check-input:checked {
            background-color: #0052FF !important;
            border-color: #0052FF !important;
        }
        .alert-danger {
            background-color: rgba(239, 68, 68, 0.1) !important;
            border: 1px solid rgba(239, 68, 68, 0.2) !important;
            color: #f87171 !important;
        }
        .text-link {
            color: #94a3b8 !important;
            transition: color 0.2s;
        }
        .text-link:hover {
            color: #0052FF !important;
        }
    </style>
</head>
<body>
    <div class="login-card animate-fade-in">
        <div class="login-header">
            <h2 class="fw-bold mb-0">
                <img src="~/images/logo.png" alt="PGKing Logo" class="login-logo">
            </h2>
            <p class="text-muted small mt-2 mb-0" style="color: #94a3b8 !important;">SuperAdmin Dashboard Access</p>
        </div>
        <div class="login-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3 small">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post">
                <div class="mb-4">
                    <label class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fas fa-user"></i></span>
                        <input type="text" name="username" class="form-control border-start-0" placeholder="superadmin" required autofocus />
                    </div>
                </div>
                
                <div class="mb-4">
                    <div class="d-flex justify-content-between">
                        <label class="form-label">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="loginPassword" class="form-control border-start-0 border-end-0" placeholder="••••••••" required />
                        <button class="btn btn-eye border border-start-0" type="button" onclick="togglePasswordVisibility('loginPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe">
                    <label class="form-check-label text-muted small" for="rememberMe" style="color: #94a3b8 !important;">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Sign In</button>
                
                <div class="text-center mt-4">
                    <a href="/" class="text-link text-decoration-none small"><i class="fas fa-arrow-left me-1"></i> Back to Home</a>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash text-muted';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye text-muted';
            }
        }
    </script>
</body>
</html>
